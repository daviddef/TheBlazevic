---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import register from "../data/register.json";
import coverage from "../data/coverage.json";

import Z from "../data/zubrinicroots.json";
import B from "../data/buckets.json";

const swept = register.filter((r) => r.kind === "swept");
const searchable = Z.fragments.filter((f) => f.state !== "bare");
const pctLinked = Math.round(100 * B.connected / B.publishedTotal);

// Every page actually opened, act by act. Ordered as read.
const READ = [
  { book: "Senj marriages", ref: "—", pages: "p.303, 307, 315, 322, 324, 326, 333, 348, 350, 355, 359",
    years: "1909 – 1919", n: 11,
    got: "Eleven marriages of this family, and every other bride on each page. The tobacco factory counted across a decade — 3 of 5 brides in 1909, rising to 7 of 8 in 1919.",
    missed: "No Blažević marriage before 1909 has been opened, and the 1920 entry that answers question 1 was read from a thumbnail." },
  { book: "Senj deaths", ref: "—", pages: "p.162, p.225", years: "1903, 1907", n: 2,
    got: "Toma Blažević's death — tuberculosis, aged 69 — and Stanko Papić's, of scarlatina at twenty months in an outbreak that killed four in eight days.",
    missed: "Two pages of one register. Everything else in the Senj death books is unread." },
  { book: "Senj baptisms", ref: "—", pages: "str.122", years: "1886", n: 1,
    got: "Milka's own baptism, and a registrar's margin of 1971 citing her death entry at page 280, line 37.",
    missed: "Her eight siblings' baptisms are attached as images and unread." },
  { book: "Krmpote — sv. Jakov, baptisms", ref: "HDA 111, HDA 176", pages: "p.104, p.168",
    years: "1888, 1895", n: 2,
    got: "Two children born at Smokvica kbr. 114 seven years apart, and two different men called Ivo Blažević standing godfather — one son of Mate, one son of Toma.",
    missed: "This is the book that should hold every Blažević above Toma. Two pages of it have been opened." },
  { book: "Krivi Put baptisms", ref: "HDA 407", pages: "p.110", years: "1859", n: 1,
    got: "Antonija Perpić at Krivi Put N° 136, her household entered Confiniarii — a Frontier family. Seven Perpić children on the one page.",
    missed: "Only the page her entry sits on." },
  { book: "Otočac baptisms", ref: "—", pages: "1834, 1845", years: "1834, 1845", n: 2,
    got: "Nicolaus at Šumećica 24, Confiniarius; Josephus in 1845 to a mother née Marković where the 1834 mother is née Orešković. Five Žubrinić Frontier offices out of the godparent columns.",
    missed: "The marriage and death registers — the two books that would settle whether there are one or two men called Michaël Žubrinić." },
  { book: "Karlobag baptisms", ref: "—", pages: "1754, 1768, 1777, 1779 (×2), 1781, 1838",
    years: "1754 – 1838", n: 7,
    got: "Every Karlobag ancestor. The Dominus honorific, a Giustiniani godfather, a Pro-Colonel, a Captain, a Baron von Holstein — and one book kept in Croatian rather than Latin.",
    missed: "Nothing outstanding on this line. This is the best-read parish in the archive." },
  { book: "Selce deaths", ref: "—", pages: "images 22, 41, 42", years: "1832, 1842", n: 3,
    got: "Two direct ancestors, both confirming the tree to the day and both adding a house number it did not have. Ahnentafel 50: “Die 1ª Aprilis 1832, house 39, Georgius Jellicich, Antonii” — with a patronymic naming his father. Ahnentafel 51: “Die 8ª Maji 1842, entry 147, house 204, Margareta Jellicich, Uxor Georgii”. Also a “Vincentius Antich, aliter Dudich”, aged 63, in January 1842.",
    missed: "Seven more direct ancestors are in this book and its companion volume, and the two houses — 39 and 204 — do not match, which leaves question 13b open." },
  { book: "Selce baptisms", ref: "3:1:3QSQ-G99C-5963-L", pages: "image 186, domus 51", years: "1838", n: 1,
    got: "Ahnentafel 12's own baptism — 11 March 1838, the tree's exact date, in the same house 51 as his parents' marriage three years earlier and by the same priest. His father is entered “Josephi Antich Papa”, which carries the by-name to the font.",
    missed: "The child's name is written Gregorium, not Georgium. The identification is beyond doubt; the given name now is not. His marriage and his 1912 death entry would each name him again." },
  { book: "Karlobag baptisms — a second sitting", ref: "—", pages: "1810, entry 23", years: "1810", n: 1,
    got: "Ahnentafel 27's own baptism: “Mathiam, Georgiam hodie natam a Georgio et Maria Uroda… Patrini fuerunt Jacobus Blaxevich et Maria conjux Joannis Uroda.” It confirms the tree's 23 April 1810 exactly, and names her parents.",
    missed: "The month read as 7ma — September — at page scale, and is a ditto mark at 3.4×. It would have gone up as a five-month correction to a tree that was right." },
  { book: "Selce marriages", ref: "—", pages: "p.21-22, domus 51 and 80", years: "1835", n: 1,
    got: "Ahnentafel 24 marrying ahnentafel 25, naming 48, 49, 50 and 51 — four direct ancestors in one line, all four already dead. The groom entered as “Josephum Antich Papa”, and his sister, marrying the bride's brother the same day, as “Euphemia Antich aliter Papa”. Five more aliter pairs on the same opening.",
    missed: "It was on disk the whole time — 2,987 pixels, attached in the tree to six direct ancestors, and counted by the coverage tool as merely <em>scanned</em>. Eleven more people on the direct line are still in that state: an image attached, nothing read out." },
  { book: "Otočac Status Animarum 1710-1846", ref: "HDA, Otočac knj. 1", pages: "the whole census — images 9-122, both pages of every opening",
    years: "1767 – 1849", n: 234,
    got: "<strong>Casparus Žubrinić, born 14 January 1767 — at Pagus Dubrava, N° Domus 60, not Šumećica.</strong> With his son <strong>Elias, 10 July 1806</strong>, and Elias's son <strong>Joannes, 19 June 1837</strong>, in one household block: the Port Pirie line three generations deep, four tree dates confirmed and two sharpened from a year to a day — Casparus died <em>4 March 1829</em>. Also <strong>fourteen Žubrinić households across six villages</strong>, a Žubrinić <em>Sylvarum Custos</em> at Luka 17, a <em>Sutor</em> among the Advenæ, a recorded name change (<em>Antonius Mihaljevich nunc Zubrinich</em>), an <strong>Untersinger</strong> household at Otočac page 29, and two Croatian firewood rolls of 1845-46 that cross-check the Latin by house number.",
    missed: "<strong>No Toma born 1768 exists anywhere in the parish</strong>, so the census cannot join the two lines. Nearest: <em>Martha vidua defti Thomæ, b. 5 July 1767</em> at Obilje — the widow of a Thomas who died before the book was written up. <strong>Corrected since:</strong> this entry used to say Šumećica's houses run 9 to 14 and that the tree's <em>Šumećica 2</em> was therefore contradicted. That was true only of the census <em>section</em>. The Otočac death register enters <span class='mono'>Shumecicza 2</span> twice — 1831 and 1835, both Žubrinić — so <strong>the address is attested and the census section is a fragment of the village</strong>." },
  { book: "Otočac deaths 1780-1836", ref: "HDA, Otočac knj. umrlih", pages: "images 240-241, 250-332 — the whole house-bearing era 1828-1836, read end to end",
    years: "1810 – 1836", n: 172,
    got: "<strong>Casparus Žubrinić's death entry — a direct ancestor.</strong> Image 289: <em>“Dubrava · 60 · Anno 1829 die 4ta Martij obiit in Domino, ex nervorum debilitate, Casparus Xubrinich hujus Parochiæ, aetatis suæ anno 62do… per me Petrum Vollarich Cooperatorem Loci”</em> — agreeing with the census at <strong>four points</strong>: house 60 at Dubrava, the margin's <em>1829 4 Martij</em>, an age of 62 against a birth of 14 January 1767, and the tree's 1767–1829. It adds <strong>how he died and who buried him</strong>. From image 284 the register rules <strong>Pagus and Domus columns</strong>, and the two books now confirm each other house by house — <span class='mono'>Dubrava 41, 60, 68 · Prozor 1, 17, 34 · Šumećica 10, 11 · Otočac 40</span>. Šumećica 10 is confirmed from outside the census, so the household's ink-blotted Domus cell no longer has to be inferred.",
    missed: "<strong>No Toma born 1768.</strong> Four men called Thomas Žubrinić are buried here — aged 24 (1824), 4½ days (1826), 5 (1829) and 44 (1831) — and seven other Thomases were ruled out at full width. <strong>A correction:</strong> this page previously said Šumećica had no house 2. It says no such thing — the register enters <em>Shumechicza 7</em> in 1830, so the numbering runs below 9 and houses 1–8 are merely absent from the census's eight pages. Also <em>vidua Martha Xubrinich</em>, Prozor 40, dead 17 April 1831 <em>sine Sacramentis ob negligentiam domesticorum</em>, aged 65 — a <strong>candidate</strong> for the widow of the census's Obilje Thomas and deliberately not identified as her: the villages differ and the ages differ by two. <strong>Šumećica 2 turns out to exist and to be a Žubrinić house</strong> — <em>Thomas filius Michaelis Xubrinich, gregarii, ætatis suæ trium dierum</em>, October 1831 — so the tree's address for Toma is attested and this archive's guess that it had to be a Military Frontier number is retired. Casparus's widow <em>Hellena Xubrinich</em> is buried from Dubrava 60 on 29 October 1831. <strong>Poljice 19</strong> buries <em>Jacobus Xubrinich, an. 22</em> and six months later <em>Mathæus Xubrinich, an. 52, ex asmate</em>. Šumećica houses 1, 3, 8 and 13 also appear, so the village numbers from 1 and the census section covered a slice of it. <strong>Poljice 19 buries four Žubrinići in eighteen months</strong> — Jacobus 22, Mathæus 52, an infant, and Appolonia 18, the last called daughter of her <em>already dead</em> father. Sixteen Žubrinić houses are now attested across five villages, and a fourth Frontier rank appears: <em>Decurio</em>. <strong>And ahnentafel 10's godfather gets a house.</strong> The 1834 baptism names <em>Petrus filius Francisci Xubrinich, Wigiliarum Magister pensionatus</em>; six weeks later, on 6 March 1834, the death register enters <span class='mono'>Shumecicza · 5 · Franciscus filius Francisci Xubrinich, Vigiliarum Magistri pensionati, ætatis suæ 1½</span> — so that household is <strong>Šumećica house 5</strong>. <strong>The register closes on a Žubrinić</strong> — <em>In Mense Augusto 1836 · Prozor 49 · Paulus Xubrinich gregarius</em> — and in April 1836 buries a husband and wife three days apart at Šumećica 6, her of pneumonia at 39, him of consumption at 43. <strong>Nineteen Žubrinić houses across five villages.</strong> <strong>1828–1836 is finished and holds no adult Thomas born in the 1760s</strong>; every Thomas in it is a child. About 90 of the 177 images are unread — and the ruled Pagus/Domus columns only begin at image 284 (1828), so the earlier stretch gives a name and an age and no house." },
  { book: "Vrbnik baptisms", ref: "—", pages: "house 244", years: "1806", n: 1,
    got: "Josephum Antić — and the underlined nadimci that answered question 5: Antich Papa, Loncsarich Franich, Antich Dudin.",
    missed: "The Selce registers 1765–1838, which would show the surname change generation by generation." },
];
// Verified 13 September 2026 by opening each film, not by reading the catalogue.
// The label on the waypoint is a claim about the parish, not about the film:
// Krmpote is catalogued 1815-1896 and the film begins in 1879.
const HOLDINGS = [
  { parish: "Senj", books: "Births 1734-1894 · Deaths 1820-1858, 1859-1907 · Marriages 1734-1858, 1859-1920",
    checked: "Marriages verified end to end — image 196 is p.192 (1885), image 371 is p.366 (1920)." },
  { parish: "Otočac", books: "Births 1834-1846, 1846-1858 · Deaths 1780-1836, 1834-1858, 1859-1872 · Marriages 1859-1872 · Church Census (Stanje duša) 1710-1846",
    checked: "Marriages verified: images 129-147, pag. 10 = 1862, pag. 18 = 1865. Census read end to end, images 9-122. Each PAGE is a full table, so an opening holds two household pages. Two numbering systems, both real: the film-target stamp is HDA = image + 243 (image 110 = HDA 353); the book's own printed page number is neither that nor a formula — image 110 is pages 220/221, image 97 is 173/174. Read it off the frame. Images 63/64, 79/80 and 89/90 are duplicate exposures." },
  { parish: "Krmpote-Vodice", books: "Births 1815-1896 — and NO marriage register, and no deaths",
    checked: "LABEL WRONG. Image 10 is page 2 and reads 1879; image 188 is page 177 and reads 1896. The film is 1879-1896.", bad: true },
  { parish: "Brinje", books: "Births 1888-1900 · Marriages 1888-1899 · Deaths 1888-1899",
    checked: "Not spot-checked." },
];

// Research plans this archive had published which cannot be carried out in this
// collection. Every one was written against a catalogue label.
const UNREACHABLE = [
  { q: "1b", want: "Juraj Blažević's marriage to Tereza Žubrinić, before 1892", why: "Krmpote-Vodice has no marriage register at all." },
  { q: "1b", want: "Juraj Blažević's own baptism — it would name his father", why: "He has no birth date in the tree and his children start in 1892, so he was born around the 1860s. The Krmpote birth film begins in 1879." },
  { q: "1d", want: "Zvonimir Vukelić's death, Senj 1915", why: "Senj deaths stop at 1907." },
  { q: "1e", want: "Miroslava Vukelić's baptism, Senj 1907", why: "Senj births stop at 1894." },
  { q: "5b", want: "Senj baptisms for January–February 1895 — the two sisters eighteen days apart", why: "Senj births stop at 1894. Both sisters fall one year outside." },
  { q: "4", want: "Otočac baptisms of Casparus (14 Jan 1767) and Toma (1768)", why: "Otočac births begin in 1834." },
  { q: "4", want: "Toma Žubrinić, b. 1768, in the Otočac church census", why: "The whole census has now been read — 234 pages — and no Toma born 1768 is in it. Casparus WAS found, at Dubrava 60. A status animarum is one living list kept to 1846, so a man dead before the recension was never carried into it." },
  { q: "4", want: "Šumećica house 2 and house 24 in the church census", why: "RESOLVED, not unreachable — and this row used to be wrong. It said the village had no house 2 and that the 1834 baptism's N° 24 must be a Military Frontier number. The death register enters Shumecicza 2 twice (1831, 1835), both Žubrinić, along with houses 1, 3, 4, 5, 6, 7, 8, 11 and 13. The census section merely begins at house 9; the village numbers from 1. No Frontier-numbering explanation is needed." },
];

const pages = READ.reduce((a, r) => a + r.n, 0);
const noDoc = coverage.filter((r) => r.state === "tree" || r.state === "named").length;
---
<Base title="What Has Been Searched"
  eyebrow="Coverage, including the books that have never been opened"
  dek={`${pages} register pages read across eight books and five parishes, yielding ${swept.length} named people. This page exists so that a null is not lost: knowing a volume has been read, or has not, is worth as much as knowing what it held.`}>

  <section class="blk">
    <div class="qa">
      <h3>Why record the negatives</h3>
      <p>An archive that publishes only its finds is <strong>unreadable as evidence</strong>. If you
      cannot tell a gap from an absence, every silence looks the same — and this archive has already
      mistaken one for the other. The <a href={u("/gazetteer/")}>name-reuse table</a> shows the
      Papići with <strong>zero</strong> infant deaths implied by a reused name and the village
      families with nine, and reads that as meaning the Papići's losses were written down. That is
      only true because <strong>somebody opened the Senj death register and nobody has opened the
      Krmpote one.</strong> The table is a map of where the reading went, not of where children
      died.</p>
      <p style="margin-top:.6rem">So: <strong>{pages} pages</strong>, and the books they came out of
      — beside what has never been touched.</p>
    </div>
  </section>

  <section class="blk">
    <div class="lab">Added 13 September 2026</div>
    <h2>What the films actually hold — and six plans that cannot be carried out</h2>
    <p class="lede">Everything below was checked by <strong>opening the film</strong>, not by reading
    the catalogue. That distinction turned out to matter: the label on a waypoint describes the
    <em>parish</em>, and the film behind it can be narrower.</p>

    <table class="reg">
      <thead><tr><th>Parish</th><th>Catalogued</th><th>Checked</th></tr></thead>
      <tbody>{HOLDINGS.map((h) => (
        <tr>
          <td><strong>{h.parish}</strong></td>
          <td class="mono dek">{h.books}</td>
          <td class={h.bad ? "warn" : "dek"}>{h.checked}</td>
        </tr>))}</tbody>
    </table>

    <div class="note" style="margin-top:1.2rem"><strong>Krmpote-Vodice is catalogued
    <span class="mono">Births 1815-1896</span>. The film begins in 1879.</strong> Image 10 is page
    two of the book and reads <em>Godine 1879</em>; image 188 is page 177 and reads
    <em>Godine 1896</em>. Sixty-four years named on the label are not behind it — and this is the
    parish that should hold every Blažević above Toma.</div>

    <h3 style="margin-top:1.6rem">Six things this archive said it would go and look up</h3>
    <p>Each of these was published as the next step for an open question. <strong>None of them can
    be done in this collection</strong>, and every one was written against a catalogue label rather
    than a film.</p>
    <table class="reg">
      <thead><tr><th>Q</th><th>What was wanted</th><th>Why it cannot be had</th></tr></thead>
      <tbody>{UNREACHABLE.map((r) => (
        <tr>
          <td class="mono"><strong>{r.q}</strong></td>
          <td>{r.want}</td>
          <td class="dek">{r.why}</td>
        </tr>))}</tbody>
    </table>
    <p style="margin-top:1.2rem"><strong>This is the most useful thing found all day</strong>, and it
    is entirely negative. Six research plans were sitting on this site looking actionable. They were
    not, and no amount of the full-resolution image access solved the same morning would have made
    them so. The books exist — they are in the <strong>Croatian State Archives</strong> and in
    parish custody — but they are not in <em>this</em> collection, and the letters already sent to
    Gospić and Senj are the route to them, not another afternoon at a film viewer.
    <a href={u("/open-questions/")}>The questions, retargeted →</a></p>
  </section>

  {READ.map((r) => (
    <section class="blk">
      <h2>{r.book} <span class="dim mono">{r.n} {r.n === 1 ? "page" : "pages"}</span></h2>
      <table class="kv">
        <tbody>
          <tr><th>Years opened</th><td class="mono">{r.years}</td></tr>
          <tr><th>Pages</th><td class="mono">{r.pages}</td></tr>
          {r.ref !== "—" && <tr><th>Shelfmark</th><td class="mono">{r.ref}</td></tr>}
          <tr><th>What it gave</th><td>{r.got}</td></tr>
          <tr><th class="warn">Not opened</th><td>{r.missed}</td></tr>
        </tbody>
      </table>
    </section>
  ))}

  <section class="blk">
    <h2>What to ask for first, and why it changed</h2>
    <p class="lede">Until 13 September 2026 the priority here was to <em>confirm</em> — to find the
    register entry behind a date the tree already gives. That was the wrong order, and one
    measurement changed it.</p>
    <p>Strip the <a href={u("/buckets/")}>sorting labels</a> out of the tree and only
    <strong>{pctLinked}%</strong> of the published people are still connected to
    <a href={u("/hedviga/")}>Hedviga</a> at all. For the <a href={u("/zubrinic/")}>Žubrinići</a> it is
    <strong>5%</strong> — 21 people out of 414. <strong>Confirming a date this archive already holds
    adds nothing to that number. Joining one fragment to the line adds a branch.</strong></p>
    <p>So the first ask is no longer a birth entry. It is a <strong>marriage</strong>, for one of the
    <strong>{searchable.length}</strong> Žubrinić fragments that carry enough detail to be searched
    for — a marriage names both parents and is the cheapest way to attach a whole household.</p>
    <table class="reg">
      <thead><tr><th>Who</th><th>Born</th><th>Where</th><th>Children</th><th>Spouse named</th></tr></thead>
      <tbody>{searchable.slice(0, 12).map((f) => (
        <tr><td>{f.name}</td><td class="mono">{f.byear || "—"}</td>
          <td class="dim">{f.village || "—"}{f.house ? " " + f.house : ""}</td>
          <td class="mono">{f.children || "—"}</td>
          <td class="dim">{f.spouse || "—"}</td></tr>))}</tbody>
    </table>
    <p class="dek" style="margin-top:1rem">Ordered by how much there is to search on.
    <a href={u("/zubrinic-roots/")}>All {searchable.length}, and the {Z.fragments.length - searchable.length}
    that cannot be searched for at all →</a></p>
  </section>

  <section class="blk">
    <h2>The books nobody has opened at all</h2>
    <div class="qa" style="margin-bottom:1.4rem">
      <div class="lab">Added 13 September 2026</div>
      <h3>Brinje, and how we found out we were on the wrong side of a mountain</h3>
      <p>The <a href={u("/kalanj/")}>Kalanj</a> baptism of 1864 describes the parents as
      <strong><em>Brinjensis parochiae ruricolae</em></strong> — country people of the parish of
      <strong>Brinje</strong>, which is inland over the Kapela and about forty kilometres from
      Klenovica where this archive has always placed them. A US passenger manifest of 1910, giving
      a Kalanj's residence as Brinje, is what made anyone go back and read the Latin.</p>
      <p><strong>Not one page of the Brinje register has been opened</strong>, and Brinje is not in
      the <a href={u("/gazetteer/")}>gazetteer</a>. Three of this archive's surnames — Kalanj,
      Perković and Borić — are recorded there.</p>
    </div>
    <p class="lede">Named because an unasked archive is not a finding, and because each of these
    would answer something this site currently marks unknown.</p>
    <table class="reg">
      <thead><tr><th>Book</th><th>What it would settle</th></tr></thead>
      <tbody>
        <tr><td><strong>Krmpote / Smokvica death registers</strong></td>
          <td>Whether the Blaževići really lost fewer children than the Papići, or whether nobody
            has looked. <a href={u("/gazetteer/")}>The reuse table depends on this.</a></td></tr>
        <tr><td><strong>Otočac marriages, before 1834 and c. 1855–70</strong></td>
          <td>Whether there are one or two men called Michaël Žubrinić — which decides four
            generations. <a href={u("/open-questions/")}>Question 4d.</a></td></tr>
        <tr><td><strong>Otočac deaths, 1834–1845</strong></td>
          <td>A Maria Žubrinić <em>née Orešković</em>, which would explain a second wife.</td></tr>
        <tr><td><strong>Selce registers, 1765–1838</strong></td>
          <td>The surname changing from Antić to Papić generation by generation — three of the four
            steps are documented and the middle one is not.</td></tr>
        <tr><td><strong>Sv. Jakov Krmpote, 1855–1892</strong></td>
          <td>Jurko Blažević's baptism or marriage. Either names his father and ends
            <a href={u("/open-questions/")}>question 1b</a>.</td></tr>
        <tr><td><strong>Senj deaths, 1915</strong></td>
          <td>How Milka came to be widowed at twenty-eight.</td></tr>
        <tr><td><strong>Senj baptisms, Jan–Feb 1895</strong></td>
          <td>Two sisters recorded eighteen days apart. Both entries fall in the same book within
            three weeks. <a href={u("/open-questions/")}>Question 5b.</a></td></tr>
        <tr><td><strong>Southern Rhodesian immigration, 1953–65</strong></td>
          <td>Twenty-two years of Hedviga's life, and an entire country known from two words on a
            later record. <a href={u("/open-questions/")}>Question 1f.</a></td></tr>
      </tbody>
    </table>
  </section>

  <section class="blk">
    <h2>What that leaves</h2>
    <p class="lede"><strong>{noDoc} of the {coverage.length} people on the direct line have no
    document of their own</strong> — they are named in somebody else's record, or the tree asserts
    them and nothing else does. Read the evidence column down the generations and it stops at the
    sixth.</p>
    <p><a class="btn" href={u("/coverage/")}>What rests on a document →</a>
      {" "}<a class="btn" href={u("/open-questions/")}>Open questions →</a>
      {" "}<a class="btn" href={u("/register/")}>The register →</a></p>
  </section>
</Base>
