   "text": "A Pro-Colonel and a Captain's wife stand for the Uroda child"
  },
  {
   "year": 1806,
   "text": "Josephum Antić baptised at Vrbnik — the family written Antich Papa"
  },
  {
   "year": 1834,
   "text": "Nicolaus Žubrinić baptised at Šumećica 24, the household entered Confiniarius"
  },
  {
   "year": 1838,
   "text": "Toma Blažević born at Smokvica kbr. 114"
  },
  {
   "year": 1859,
   "text": "Antonija Perpić born at Krivi Put 136 — Confiniarii"
  },
  {
   "year": 1885,
   "text": "Josip Papić, bremenar, marries Antonija Perpić at Senj"
  },
  {
   "year": 1886,
   "text": "Milka born at Senj"
  },
  {
   "year": 1892,
   "text": "Ljubomir Blažević born"
  },
  {
   "year": 1903,
   "text": "Stanko Papić dead of scarlatina at twenty months"
  },
  {
   "year": 1907,
   "text": "Toma Blažević dies of tuberculosis, a day-labourer in the town"
  },
  {
   "year": 1920,
   "text": "Ljubomir marries Milka — the entry that joined this pedigree"
  },
  {
   "year": 1926,
   "text": "Hedviga born at Senj"
  },
  {
   "year": 1943,
   "text": "Pavao Kosina killed in the air raid on Senj"
  },
  {
   "year": 1945,
   "text": "Oto Blažević dies, aged twenty-two"
  },
  {
   "year": 1948,
   "text": "Ladislava born at Crikvenica"
  },
  {
   "year": 1953,
   "text": "Robert born at Senj — the last trace of the family in Croatia"
