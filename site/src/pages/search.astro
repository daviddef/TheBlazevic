---
/* The box is one component in @daviddef/archive-kit, shared by all seven
   archives. What stays here is what belongs to this archive: how it describes
   itself, and the things worth trying. */
import Base from "../layouts/Base.astro";
import Search from "@daviddef/archive-kit/components/Search.astro";
import { u } from "../lib/url.js";

const hints = [["tvornici duhana", "the tobacco factory"], ["Confiniarius", "Military Frontier households"], ["Smokvica", "the zadruga at house 114"], ["Krivi Put", "the Prpić village"], ["nadglednica", "the supervisors"], ["Rivosecchi", "a recurring witness"], ["Xubrinich", "the Venetian X"], ["1943", "the raid on Senj"]];
---
<Base title="Search" eyebrow={"Everything this archive can point at, in one box"} dek="People, places, records read out of a register, documents, corrections and every page — searched together. Type without the accents if it is easier: Zubrinic finds Žubrinić, Otocac finds Otočac.">
  <section class="blk">
    <Search base={u("/")} hints={hints} placeholder="Žubrinić · tvornici duhana · Smokvica 114 · 1943 · Therapia" />
    <p class="dek" style="margin-top:1.4rem">This searches <strong>what the archive says</strong>,
    not the registers themselves. A name that returns nothing here has not been read yet — which is
    itself worth knowing. <a href={u("/searched/")}>What has already been looked for &rarr;</a></p>
  </section>
</Base>
