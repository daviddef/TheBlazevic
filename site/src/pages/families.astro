---
import Base from "../layouts/Base.astro";
import Families from "@daviddef/archive-kit/components/Families.astro";
import { u } from "../lib/url.js";
import families from "../data/families.json";
import { COPY } from "../lib/familyCopy.js";
import { householdsOf, familyKeys } from "../lib/households.js";

/* 22 September 2026. The card is the kit's. What this archive can put behind
   the claim is NOT people — it has no member list — so it gives what it does
   have: a count, the span of birth years, how many spellings the registers
   use for the name, and the chief place. D'Arcy names the people; Falco
   draws the marriages generation by generation. Three archives, one
   argument, three kinds of evidence, and the component requires none of them.

   Every family with a page links to it. That used to be only the first four,
   and the other four had pages for weeks that nothing on this index pointed
   to; on 14 October 2026 five more were added and the link now follows the
   page, not a hand-kept list. */
const OURS = ["blazevic", "zubrinic", "papic", "prpic"];
/* THE INDEX COUNTED PEOPLE AND SAID NOTHING ABOUT COUPLES. Each family
   page now draws its households — fifty-seven on Papić — and the index
   that sends a reader there gave no hint of what was behind the link.
   Counted from the same builder the pages use, so the two can never
   disagree about how many couples a surname has. */
const HH = Object.fromEntries(
  families.map((f) => [f.slug, householdsOf(familyKeys(f.slug)).length]));

const groups = [{
  rows: families.map((f) => ({
    label: f.label,
    href: COPY[f.slug] ? `/${f.slug}/` : null,
    hrefLabel: COPY[f.slug] ? "The family" : null,
    gloss: f.dek,
    count: f.count,
    countLabel: "people",
    facts: [
      ["Births span", `${f.earliest ?? "?"} – ${f.latest ?? "?"}`],
      ["Spellings", String(f.spellings.length)],
      ["Chief place", f.places[0] ? f.places[0][0] : "—"],
      ["Couples", HH[f.slug] ? String(HH[f.slug]) : "none recorded"],
    ],
  })),
}];
---
<Base title="The Families"
  eyebrow="Thirteen surnames"
  dek="The four that make Hedviga's grandparents, and nine more that married into them or sit beside them in the registers. Counts are of published people only — the living are not here."
>
  <section class="blk">
    <Families groups={groups} u={u} html={false} />
  </section>
  <section class="blk">
    <p class="note">The nine after the first four are here because they married into the line
    and because the tree or the Senj registers carry them in bulk — <strong>{families.find((f) => f.slug === "kalanj").count} Kalanj</strong> alone, nearly all of
    them at <strong>Klenovica</strong> and <strong>Povile</strong> on the Vinodol coast.
    Pavelić, Tomljanović, Krmpotić, Babić and Špalj are the newest: each is built from the tree
    and from the Senj marriage-and-death volume read in October 2026, and Tomljanović holds
    ahnentafel 111. Most are not ancestors of Hedviga; they are the surrounding world.
    <a href={u("/people/")}>The full register →</a></p>
  </section>
</Base>
