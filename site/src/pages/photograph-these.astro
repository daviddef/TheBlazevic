---
import Base from "../layouts/Base.astro";
import Shotlist from "@daviddef/archive-kit/components/Shotlist.astro";
import { u } from "../lib/url.js";
import data from "../data/photograph-these.json";

/* 21 September 2026. Two changes and the second is the one that mattered.
   The card moved to the kit; and the eight jobs, which were hard-coded in
   this file as a JavaScript array, moved to src/data/photograph-these.json,
   because a list only a template can reach cannot be counted, checked or
   added to — the failure this estate has already lifted the sources page,
   the errands and the audit out of.

   The GRADE stays here. "first / when passing / if you get there" ranks by
   how much effort the trip is worth, which is this archive's question and
   not Lerena's numbered priority or Defranceski's walk. */
const PRI = { "first": ["Go here first", "var(--terra)"],
              "when passing": ["When you are passing", "#8a7f5c"],
              "if you get there": ["If you get that far", "var(--rule-strong)"] };
const ORDER = ["first", "when passing", "if you get there"];
const unlabelled = [...new Set(data.jobs.map((j) => j.pri).filter((k) => !PRI[k]))];

const groups = ORDER
  .map((pri) => ({
    label: PRI[pri][0],
    rows: data.jobs.filter((j) => j.pri === pri).map((j) => ({
      where: j.where, what: j.what, why: j.why, colour: PRI[pri][1],
    })),
  }))
  .filter((g) => g.rows.length);
---
<Base title="Photograph These"
  eyebrow="For whoever is next in Croatia"
  dek="Seven places and four kinds of paper. Each one is here because a specific claim on this site would move if somebody stood in front of it with a phone — not because it would be nice to have."
  >

  <section class="blk">
    <p class="lede">This archive has been built from a family tree, a media library and about
    thirty pages of parish register read on a screen. <strong>Nobody involved in it has stood in
    any of these places.</strong> A phone is enough for all of it; none of this needs an
    appointment, and most of it needs no permission.</p>
    <p><strong>Photograph the whole thing and then the detail.</strong> A stone shot only close up
    cannot be placed in its row; a stone shot only wide cannot be read. And photograph the ones
    that look like nothing — a wrong house number is worth knowing too.</p>
  </section>

  <section class="blk">
    <Shotlist groups={groups} u={u} html={false} />
    {unlabelled.length > 0 && (
      <p class="small">Filed under an effort this page has no label for: {unlabelled.join(", ")}.</p>
    )}
  </section>

  <section class="blk">
    <h2>And anything on paper</h2>
    <table class="reg">
      <thead><tr><th>What</th><th>Why it matters here</th></tr></thead>
      <tbody>{data.paper.map(([w, y]) => (
        <tr><td><strong>{w}</strong></td><td class="dim">{y}</td></tr>))}</tbody>
    </table>
    <p style="margin-top:1.2rem">If you are holding a photograph and cannot say who is in it,
    that is worth as much — <a href={u("/faces/")}>the contact sheet</a> is fifteen pictures this
    archive cannot vouch for, and one conversation would close most of it.</p>
  </section>
</Base>
