---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import families from "../data/families.json";
import { COPY } from "../lib/familyCopy.js";
import Descent from "@daviddef/archive-kit/components/Descent.astro";
import { householdsOf, descentOf } from "../lib/households.js";
import FOUND from "../data/found.json";
import line from "../data/line.json";

export function getStaticPaths() {
  return Object.keys(COPY).map((slug) => ({ params: { family: slug } }));
}
const { family } = Astro.params;
const meta = families.find((f) => f.slug === family);
const copy = COPY[family];
// Perpic folds into Prpic, as everywhere else here; every other family is itself.
const keys = { prpic: ["prpic", "perpic"] }[family] || [family];

/* THREE SECTIONS BECAME ONE ON 29 SEPTEMBER 2026. This page used to draw
   "The households" (couples, chip children), "Everyone of the name,
   generation by generation" (the Descent tree) and a flat "Every person of
   the name" table with a birthplace column, in that order — three renderings
   of nearly the same people. Asked directly why a reader would see the same
   couples three times, checking rather than assuming found that `descentOf`
   below is already a strict superset of both: it includes everyone the
   households builder excludes (anyone with neither spouse nor child, and
   every found.psv register-only person the flat table never listed at all),
   and it already prints a birthplace beside every name via `dsc-place` — the
   flat table's own claim to be "the only place on this page that prints a
   birthplace" was false the day the Descent section shipped. Only the
   households builder's *count* of empty/single-parent couples was worth
   keeping, so it stays, feeding the one honesty note below; the cards and
   the flat table do not. */
const households = householdsOf(keys, new Set(line.map((g) => g.id)));
const childless = households.filter((h) => !h.children.length).length;
const soleParent = households.filter((h) => !h.spouse).length;

/* AND EVERY PERSON OF THE NAME, drawn as the front page draws a generation.
   Asked for on 22 September: the family pages should use the same shape as
   the descent, and should list everyone the archive holds of the surname
   rather than only the couples — which left fifty-nine of Papić's hundred
   and sixteen off the page because they never married.

   The register-only people come in with them. They have had a page under
   /found/ since this morning and they belong beside their own family, with
   a pill saying which side of the tree they fall on — a fact about the
   MyHeritage export, not about the evidence. */
const familyDoors = families.map((f) => ({ label: f.label, href: `/${f.slug}/` }));
const everyone = descentOf(keys, new Set(line.map((g) => g.id)), FOUND.rows || []);
---
<Base title={meta.label} eyebrow={copy.eyebrow} dek={copy.dek}>
  <section class="blk">
    <div class="grid three">
      <div class="stat"><div class="n">{meta.count}</div><div class="l">published people</div></div>
      <div class="stat"><div class="n">{meta.earliest ?? "?"}</div><div class="l">earliest birth year</div></div>
      <div class="stat"><div class="n">{meta.spellings.length}</div><div class="l">distinct spellings in the tree</div></div>
    </div>
  </section>

  {/* THE PROSE USED TO BE ONE PARAGRAPH PER SECTION, however long, because the
      template wrapped it in a single <p>. Writers worked round that with <br><br>,
      which is a paragraph break that carries none of the page's paragraph spacing
      and none of its furniture. On 27 September 2026 the copy was migrated to real
      <p> tags and this became a set:html on the block itself — so a family section
      can now use what /kosina/ uses: an <h3> turn, a <blockquote class="note"> for
      what a register actually says, a <div class="note"> for an aside and a
      <div class="fix"> for a retraction. */}
  {copy.body.map(([h, html]) => (
    <section class="blk">
      <h2>{h}</h2>
      <div set:html={html.replace(/href='\//g, `href='${u("/")}`.replace("//", "/"))} />
    </section>
  ))}

  <section class="blk">
    <h2>Where they were born</h2>
    <ul class="cols">{meta.places.map(([pl, n]) => (
      <li><span class="mono dim">{n}</span> {pl}</li>))}</ul>
  </section>

  <section class="blk">
    <h2>How the tree spells it</h2>
    <ul class="cols">{meta.spellings.map(([w, n]) => (
      <li><span class="mono">{w}</span> <span class="dim">× {n}</span></li>))}</ul>
  </section>

  <section class="blk">
    <h2>Everyone of the name</h2>
    <p class="dek">All <strong>{everyone.length}</strong> people this archive holds of the name,
    oldest first, in the shape the front page uses — the couple in two columns with a birthplace
    beside each name, the children beneath them, brothers and sisters under whichever of the two
    they belong to. <strong>Oldest first</strong>, which is the only order a family has, and
    everything is shut until you open it. The rows marked <em>parish register</em> are people read
    off a page that the family tree has never had; they are not less proved, they are just not
    typed in.</p>
    {childless > 0 && (
      <div class="note"><strong>{childless} of the {households.length} married couples here have
        no child recorded under them</strong>{soleParent > 0 && <>, and <strong>{soleParent}</strong>{" "}
        are a single parent with no spouse in the tree at all</>}.
        <span style="display:block;margin-top:.6rem">That is worth saying rather than
        hiding, because <strong>it is a fact about the family tree and not about the
        family</strong>. A couple reaches this archive childless when they were
        entered from one index hit and nobody went back for the baptisms — and the
        children most often missing are the ones who died small, who are exactly the
        children a register does record and an index does not.</span></div>
    )}
    <Descent rows={everyone} u={u} archiveKey="blazevic" families={familyDoors} />
  </section>
</Base>
