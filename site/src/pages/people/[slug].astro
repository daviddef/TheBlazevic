---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import { people, lifespan } from "../../lib/people.js";
import corrections from "../../data/corrections.json";
import media from "../../data/media.json";
import latin from "../../data/latincases.json";
import evidence from "../../data/evidence.json";
import readings from "../../data/readings.json";
import linkage from "../../data/linkage.json";
import dupes from "../../data/duplicates.json";
import placefixes from "../../data/placefixes.json";
import buckets from "../../data/buckets.json";
import PersonTree from "../../components/PersonTree.astro";
import found from "../../data/found.json";
import ancestors from "../../data/ancestors.json";

export function getStaticPaths() {
  return people.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;

/* PEOPLE READ IN A REGISTER FOR *THIS* PERSON, who are in no tree and so cannot
   be relatives in the chart above. Added 23 September 2026 after an audit asked
   whether the research reaches the pages: 44 people this archive has read a
   document for were reachable only from /found/, and invisible on the page of
   the very sibling or parent they were found beside. Joannis Georgius Uroda had
   his father, his mother and five brothers and sisters in found.psv, with
   citations, and his own page named none of them.
   The join is the ahnentafel number the found row already writes in words —
   «brother of ahnentafel 54» — so nothing new is asserted here; it is the same
   sentence, read by the page it is about. */
const ahnSlug = new Map(ancestors.filter((a) => a.ahn != null).map((a) => [a.ahn, a.slug]));
const myAhn = (ancestors.find((a) => a.slug === p.slug) || {}).ahn;
/* A found row that CARRIES an ahnentafel number is somebody the tree does hold —
   they are published as an ancestor and deliberately have no /found/ page. Link
   them where they actually live. check:kit caught this as two dead links the
   first time this section was built, which is the gate doing its job on the very
   fault this section exists to fix. */
const whereIs = (r) => (r.ahn != null && ahnSlug.has(r.ahn))
  ? u(`/people/${ahnSlug.get(r.ahn)}/`)
  : (r.slug ? u(`/found/${r.slug}/`) : null);
const foundHereRaw = myAhn == null ? [] : (found.rows || []).filter((r) =>
  new RegExp(`ahnentafel\\s+(?:\\d+(?:\\s*(?:,|and)\\s*)?)*\\b${myAhn}\\b`, "i")
    .test(r.relation || ""));
const foundHere = foundHereRaw;
const foundOutside = foundHereRaw.filter((r) => !(r.ahn != null && ahnSlug.has(r.ahn))).length;
const occ = (p.occupations || []).filter((o) => o.what || o.where);
const events = (p.events || []).filter((e) => e.date || e.place || e.note || e.detail);
const notes = (p.notes || []).filter((n) => n && n.length > 2);
const rel = p.rel || null;
// place strings in the tree that name a real place hundreds of km from the event
const badPlaces = placefixes.bySlug[p.slug] || [];
const parents = rel?.parents ?? [];
// The tree gives some people a sorting label where a father should be — a
// drawer, not a parent. Those are filtered out of `rel` at build time, which
// would otherwise leave the gap silent. Say it instead.
const drawer = (buckets.orphaned || []).find((o) => o.slug === p.slug);
const spouses = rel?.spouses ?? [];
const siblings = rel?.siblings ?? [];
const children = rel?.children ?? [];
const fixes = corrections.filter((c) => c.id === p.id);
const lat = latin.find((l) => l.id === p.id);
// Everything in the media library that is tagged to this person, documents
// first, because a register scan and a holiday snapshot are not the same claim.
const mine = media
  .filter((m) => (m.people || []).some((x) => x.id === p.id))
  .sort((a, b) => (a.kind === b.kind ? (b.w * b.h) - (a.w * a.h)
                                     : a.kind === "document" ? -1 : 1));
// Others of the same name. These parishes repeat their names relentlessly —
// 94 Marijas, 88 Ivans — and merging on a name is precisely how the tree came
// to hold a man born after his own granddaughter.
const norm = (x) => (x || "").toLowerCase().replace(/["“”]/g, "")
  .replace(/\s*\(.*?\)\s*/g, " ").replace(/\s+/g, " ").trim();
const sameName = people
  .filter((q) => q.slug !== p.slug && norm(q.name) === norm(p.name))
  .slice(0, 24);
const ev = evidence[p.slug] || { state: "tree", media: 0 };
// What has actually been READ for this person, with the citation. The state
// badge above says a document exists; until 20 September 2026 no page said
// what it said. sources/readings.psv held 111 of these and was published nowhere.
const read = (readings.bySlug[p.slug] || { rows: [] }).rows;
// The same five states the coverage table counts, as a chip: the sentence
// below says it properly, this says it at a glance. Colour by how far the
// claim is from a record, not by how flattering it is.
const EVCHIP = {
  read:     ["doc",  "Read"],
  line:     ["inf",  "Direct line"],
  scanned:  ["inf",  "Scanned, not read"],
  indexed:  ["inf",  "In an index"],
  tree:     ["lore", "Tree only"],
  disputed: ["dis",  "Disputed"],
};
const chip = EVCHIP[ev.state] || EVCHIP.tree;
const EV = {
  line: "a direct ancestor, with no record of their own read here",
  read: "a register or certificate has been read for this person",
  scanned: "an image is attached to them that has not been read out",
  indexed: "an index names them \u2014 somebody else\u2019s transcription, not a document read here",
  tree: "everything here comes from the family tree, and is unverified",
  disputed: "this archive has shown something recorded about them to be wrong",
};

const KIND = { corrected: "Corrected against the register",
               disputed: "Disputed — this attachment does not hold",
               upgraded: "Upgraded — now documented",
               note: "Noted" };
const link = linkage[p.id];
// the confirmed duplicate group this person belongs to, if any
const dup = (dupes.groups || []).find(
  (g) => !g.tier.startsWith("rejected") && g.ids.includes(p.id));
const dupOther = dup ? dup.names.map((n, i) => ({ n, slug: dup.slugs[i] }))
  .filter((x) => x.slug !== p.slug) : [];
---
<Base title={p.name} eyebrow={p.ancestor ? `Direct ancestor · generation ${p.gen ?? "—"}` : p.surname}
      dek={`${lifespan(p)}${p.bornPlace ? " · " + p.bornPlace : ""}`}>

  {dup && dupOther.length > 0 && (
    <section class="blk">
      <div class="fix disputed">
        <div class="lab">This person appears twice in the tree</div>
        <h2 style="margin-top:.3rem">The same person, entered {dup.n} times</h2>
        <table class="kv tight" style="margin-top:.6rem">
          <tr><th>Also entered as</th><td>{dupOther.map((x, i) => (
            <span>{i > 0 && <span class="dim">  ·  </span>}
              {x.slug ? <a href={u("/people/" + x.slug)}>{x.n}</a> : x.n}</span>))}</td></tr>
          <tr><th>What they share</th><td class="mono">{dup.date || dup.byear}{dup.place ? " · " + dup.place : ""}</td></tr>
          <tr><th>How certain</th><td>{dup.tier === "same day"
            ? "Identical full birth date, and the parents do not conflict"
            : dup.tier === "same year and place"
              ? "Same given name, birth year and place, parents agreeing where both are named"
              : "Same given name and birth year only — the weakest tier"}</td></tr>
        </table>
        <p style="margin-top:.9rem"><strong>Nothing has been merged.</strong> This archive
        <a href={u("/method/")}>reports the tree rather than editing it</a>, and here the tree holds
        one person more than once. The count of published people on this site is therefore slightly
        higher than the number of actual people. <a href={u("/duplicates/")}>How this is judged →</a></p>
      </div>
    </section>
  )}

  {link && (
    <section class="blk">
      <div class="fix disputed">
        <div class="lab">How this person is attached</div>
        <h2 style="margin-top:.3rem">{link.only
          ? "The only parent on record here is not a person"
          : link.label
            ? "One parent on record here is not a person"
            : "Connected to this family only through a sorting label"}</h2>
        {link.label && (
          <table class="kv tight" style="margin-top:.6rem">
            <tr><th>Entered as the parent</th><td><span class="mono">{link.label}</span></td></tr>
          </table>
        )}
        <p style="margin-top:.9rem">
          {link.label
            ? <span>That is a <strong>sorting label</strong> — a note somebody typed into the
              parent's slot while working through records. No priest wrote it and nobody was called
              it. {link.only
                ? <span>It is the <strong>only</strong> parent this record has, so nothing documented
                  attaches this person to anyone.</span>
                : <span>The other parent is a real record.</span>}</span>
            : <span>Every route from <a href={u("/hedviga/")}>Hedviga</a> to this person passes
              through a <strong>sorting label</strong> — a working note sitting where an ancestor
              should be.</span>}
          {" "}This is not a claim that the person is invented; the register entries behind them are
          real. It is a statement about <em>the join</em>. <a href={u("/buckets/")}>Why this matters →</a>
        </p>
      </div>
    </section>
  )}

  {fixes.length > 0 && fixes.map((c) => (
    <section class="blk">
      <div class={`fix ${c.kind}`}>
        <div class="lab">{KIND[c.kind]}</div>
        <h2 style="margin-top:.3rem">{c.what}</h2>
        <table class="kv tight" style="margin-top:.6rem">
          <tr><th>The tree says</th><td>{c.tree}</td></tr>
          <tr><th>The record says</th><td><strong>{c.record}</strong></td></tr>
        </table>
        <p style="margin-top:.9rem">{c.why} <a href={u(c.href)}>Read it →</a></p>
      </div>
    </section>
  ))}

  {lat && (
    <section class="blk">
      <div class="fix corrected">
        <div class="lab">A grammatical artefact, not a name</div>
        <h2 style="margin-top:.3rem">He was not called “{lat.recorded}”</h2>
        <table class="kv tight" style="margin-top:.6rem">
          <tr><th>The tree records</th><td><strong>{lat.recorded}</strong></td></tr>
          <tr><th>Which is</th><td>the <strong>{lat.case}</strong> of
            <strong>{lat.nominative}</strong></td></tr>
        </table>
        <p style="margin-top:.9rem">These registers are narrative Latin. A priest writing
        <em>baptizavi <strong>Josephum</strong></em> — “I baptised Josephus” — is writing a case
        ending, and <em>filius <strong>Josephi</strong></em> is “son of Josephus”. Transcribed
        literally, the ending becomes the name. In life this person was
        <strong>{lat.nominative}</strong>, or its Croatian form.
        <a href={u("/name/")}>All forty of them →</a></p>
      </div>
    </section>
  )}

  <section class="blk">
    <table class="kv">
      {p.born && <tr><th>Born</th><td>{p.born}{p.bornPlace &&
        <>, <a href={u(`/people/?q=${encodeURIComponent(p.bornPlace.split(",")[0])}`)}>{p.bornPlace}</a></>}</td></tr>}
      {p.baptised && <tr><th>Baptised</th><td>{p.baptised}{p.baptisedPlace ? `, ${p.baptisedPlace}` : ""}</td></tr>}
      {p.died && <tr><th>Died</th><td>{p.died}{p.diedPlace &&
        <>, <a href={u(`/people/?q=${encodeURIComponent(p.diedPlace.split(",")[0])}`)}>{p.diedPlace}</a></>}</td></tr>}
      {badPlaces.map((f) => (
        <tr><th class="warn">Place</th><td>
          <strong>The {f.field} place above names the wrong town.</strong> It reads
          <span class="mono"> {f.reads}</span>, which is a real place <strong>{f.km} km</strong>
          away. The place meant is <strong>{f.actually}</strong>.
          <div class="dim" style="margin-top:.4rem">{f.why}</div>
        </td></tr>))}
      {p.cause && <tr><th>Cause</th><td class="mono">{p.cause}</td></tr>}
      {p.burial && <tr><th>Buried</th><td>{p.burial}</td></tr>}
      {occ.length > 0 && (
        <tr><th>Occupation</th><td>{occ.map((o) => (
          <div>{o.what}{o.where ? <span class="dim"> — {o.where}</span> : null}</div>))}</td></tr>)}
      {p.family && <tr><th>Line</th><td><a href={u(`/${["blazevic","zubrinic","papic","prpic"].includes(p.family) ? p.family : "families"}`)}>{p.surname}</a> · <a href={u(`/people/?fam=${p.family}`)}>everyone of the name →</a></td></tr>}
      {p.ahn && <tr><th>Ahnentafel</th><td class="mono">{p.ahn} — generation {p.gen}{p.gen === 1 ? "" : ", a direct ancestor of Hedviga"}</td></tr>}
      <tr><th>Record</th><td class="mono">{p.id}</td></tr>
    </table>
  </section>

  {drawer && (
    <section class="blk">
      <h2>No parent is recorded for this person</h2>
      <p>The family tree does give one. It is not a person: it is
      <strong class="mono">{drawer.parent}</strong> — a <strong>sorting label</strong>,
      one of the drawers a researcher used to hold names they had not placed yet.
      This archive does not publish those as ancestors, so the space above is
      empty rather than filled with a filing system.</p>
      <p class="dek"><strong>It is not a small thing.</strong> {buckets.orphaned.length} published
      people here have a label where a father should be, and {buckets.hanging} hang off one
      somewhere. <a href={u("/buckets/")}>What the labels are →</a></p>
    </section>
  )}

  {rel && (parents.length + spouses.length + siblings.length + children.length) > 0 && (
    <section class="blk">
      <h2>Family</h2>
      <PersonTree person={p} parents={parents} spouses={spouses}
                  children={children} siblings={siblings} />
    </section>
  )}

  {read.length > 0 && (
    <section class="blk">
      <div class="lab">{read.length} {read.length === 1 ? "document" : "documents"} read</div>
      <h2>What the registers say about {p.given || p.name}</h2>
      <table class="reg">
        <thead><tr><th style="width:8%">Year</th><th style="width:16%">Document</th>
          <th>The citation, in the register's own words</th></tr></thead>
        <tbody>{read.map((r) => (
          <tr>
            <td class="mono">{r.year}</td>
            <td class="dek"><strong>{r.kind}</strong>
              {r.indexOnly && <span class="dek" style="display:block">index only — the page has not been opened</span>}</td>
            <td class="dek">{r.cite}
              {r.derived && <span class="dek" style="display:block">Named on {r.viaName || r.via}'s
                entry rather than their own — <em>a register names you</em> is not
                <em> a register is about you</em>.</span>}
              {r.href && <span style="display:block"><a href={r.href}>{r.where}</a></span>}</td>
          </tr>
        ))}</tbody>
      </table>
      <p class="dek" style="margin-top:.7rem"><a href={u("/readings/")}>Every document this archive has read →</a></p>
    </section>
  )}

  {foundHere.length > 0 && (
    <section class="blk">
      <div class="lab">Read in a register, for this person</div>
      <h2>{foundHere.length === 1 ? "One more person" : `${foundHere.length} more people`} found
        beside {p.given || p.name}</h2>
      <p class="lede">Every one of these was read out of a parish register
      <strong>for this person</strong> — named in an entry that is about
      {" " + (p.given || p.name)}, or beside {p.sex === "F" ? "her" : "him"} in one.
      {foundOutside > 0 && <span> <strong>{foundOutside === foundHere.length
        ? "The family tree holds none of them"
        : `The family tree holds ${foundHere.length - foundOutside} of them and not the other ${foundOutside}`}</strong>,
        so {foundOutside === 1 ? "that one cannot" : "they cannot"} appear in the chart above.</span>}
      <strong> This is evidence standing beside the tree rather than inside it.</strong></p>
      <table class="reg">
        <thead><tr><th style="width:26%">Who</th><th style="width:30%">How they stand to
          {" " + (p.given || p.name)}</th><th>Read from</th></tr></thead>
        <tbody>{foundHere.map((r) => (
          <tr>
            <td>{whereIs(r)
                  ? <a href={whereIs(r)}><strong>{r.name}</strong></a>
                  : <strong>{r.name}</strong>}
              <span class="tag">{r.ahn != null && ahnSlug.has(r.ahn)
                ? "in the family tree, on the direct line"
                : "parish register · not yet in the family tree"}</span></td>
            <td class="dek">{r.relation}</td>
            <td class="dek">{r.event}{r.date ? `, ${r.date}` : ""}{r.place ? ` · ${r.place}` : ""}</td>
          </tr>
        ))}</tbody>
      </table>
      <p class="dek" style="margin-top:.8rem"><a href={u("/found/")}>Everyone this tree does not
      have →</a></p>
    </section>
  )}

  <section class="blk">
    <div class="grid two">
      <div class="card">
        <h3>Where this comes from</h3>
        <p class="chips"><span class={"chip " + chip[0]}>{chip[1]}</span></p>
        <p><strong>{EV[ev.state]}.</strong></p>
        {ev.media > 0 && (
          <p class="dek" style="margin-top:.5rem">{ev.media}
            {" "}{ev.media === 1 ? "image is" : "images are"} attached to this person
            {mine.filter((m) => m.kind === "document").length > 0
              ? <span>, of which {mine.filter((m) => m.kind === "document").length}
                  {mine.filter((m) => m.kind === "document").length === 1
                    ? " is a document" : " are documents"} rather than
                  {mine.filter((m) => m.kind === "document").length === 1
                    ? " a photograph." : " photographs."}</span>
              : "."}</p>)}
        {fixes.length > 0 && (
          <p class="dek" style="margin-top:.5rem">{fixes.length}
            {" "}{fixes.length === 1 ? "correction or note has" : "corrections and notes have"} been
            recorded against this page — set out above, and listed on
            {" "}<a href={u("/corrections/")}>What changed</a>.</p>)}
        {p.ahn && (
          <p class="dek" style="margin-top:.5rem">
            <a href={u("/coverage/")}>How much of the direct line rests on a document →</a></p>)}
        <p style="margin-top:.7rem">
          <a href={u("/register/") + "?q=" + encodeURIComponent(p.surname || p.name)}>Every
          record naming {p.surname || p.name} →</a></p>
      </div>

      <div class="card">
        <h3>{p.ahn ? "Where this sits on the line" : "Where this sits in the family"}</h3>
        {p.ahn ? (
          <p>Ahnentafel <strong class="mono">{p.ahn}</strong> — <strong>generation {p.gen}</strong>
          {" "}of Hedviga's descent. Every person's father is twice their own number and their
          mother twice plus one, so this person's parents are
          {" "}<span class="mono">{p.ahn * 2}</span> and <span class="mono">{p.ahn * 2 + 1}</span>.</p>
        ) : (
          <p>Not on the direct line. They are published because they belong to one of
          {" "}<a href={u("/families/")}>the eight surnames</a> this archive follows.</p>
        )}
        <p class="dek" style="margin-top:.5rem">The register spells this surname
        {" "}<a href={u("/name/")}>more than one way</a>, and the search folds the forms together —
        so <em>Xubrinich</em> and <em>Žubrinić</em>, <em>Joannis</em> and <em>Ivan</em>, find each
        other.</p>
        <p style="margin-top:.7rem">
          {p.ahn && <><a href={u("/direct-line/")}>The spine →</a><br /></>}
          <a href={u("/gazetteer/")}>Where this surname sits on the map →</a><br />
          <a href={u("/impossible/")}>What the tree says that cannot be true →</a></p>
      </div>
    </div>
  </section>

  {events.length > 0 && (
    <section class="blk">
      <h2>Events, as the record has them</h2>
      <ul class="eventlog">
        {events.map((e) => (
          <li>
            <span class="lab">{e.kind}</span>
            <strong>{e.date}</strong> {e.place}
            {e.detail && e.detail !== "Y" && <div class="src">{e.detail}</div>}
            {e.note && <div class="src">{e.note}</div>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {notes.length > 0 && (
    <section class="blk">
      <h2>Notes carried in the tree</h2>
      <p class="dek">Reproduced as written, minus the automated copy-reference boilerplate. These
      are what the family and other researchers put down, not what this archive has verified.</p>
      {notes.map((n) => <blockquote class="note">{n}</blockquote>)}
    </section>
  )}

  {mine.length > 0 && (
    <section class="blk">
      <h2>Documents and photographs</h2>
      <p class="dek">{mine.filter((m) => m.kind === "document").length} document{
        mine.filter((m) => m.kind === "document").length === 1 ? "" : "s"} and {
        mine.filter((m) => m.kind === "photograph").length} photograph{
        mine.filter((m) => m.kind === "photograph").length === 1 ? "" : "s"} in the
        MyHeritage media library carry this person's tag. None of them travelled in the GEDCOM.
        <a href={u("/pictures/")}>All of them →</a></p>
      <div class="photos">
        {mine.map((m) => (
          <figure>
            {m.type === "document"
              ? <a class="pdf" href={u(`/photos/line/${m.file}`)}>PDF — {m.caption}</a>
              : <img src={u(`/photos/line/${m.file}`)} alt={m.caption} loading="lazy" />}
            <figcaption>
              <strong>{/^\d|^scan|^IMG|unnamed/.test(m.caption) ? "Untitled" : m.caption}</strong>
              {m.w > 0 && <span class="dim"> · {m.w}×{m.h}</span>}
              {m.kind === "document" && <span class="tag">document</span>}
              {m.people.length > 1 && (
                <div class="dim">Also tagged: {m.people.filter((x) => x.id !== p.id)
                  .map((x, i) => (<>{i > 0 && ", "}{x.slug
                    ? <a href={u(`/people/${x.slug}/`)}>{x.name}</a> : x.name}</>))}</div>)}
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="note"><strong>A tag says somebody linked this image to this person</strong> — not
      that the person is in it. A register page is tagged to everyone it names.
      <a href={u("/method/")}>Method →</a></p>
    </section>
  )}

  <section class="blk">
    <h2>Sources attached in the tree</h2>
    {p.sources && p.sources.length > 0 ? (
      <ul class="srclist">{p.sources.map((s) => <li class="src">{s}</li>)}</ul>
    ) : (
      <p class="note"><strong>None.</strong> This person carries no source string at all in the
      tree. They may still be right — but nothing here can be checked without going to the
      register. <a href={u("/method/")}>Method →</a></p>
    )}
    <p class="dek" style="margin-top:1rem">An online family tree is a <strong>witness, not a
    source</strong>. Where a citation points at a parish register or a FamilySearch image, that is
    the thing worth going to. <a href={u("/sources/")}>Sources →</a></p>
  </section>
  {sameName.length > 0 && (
    <section class="blk">
      <h2>Others of the same name</h2>
      <p class="lede">These parishes repeat their names relentlessly — <strong>94 Marijas and 88
      Ivans</strong> in this archive alone. <strong>These are different people, kept apart on
      purpose rather than merged into one.</strong> Merging on a name is exactly how this tree came
      to hold <a href={u("/people/caetano-bacchi/")}>a man born after his own granddaughter</a>.</p>
      <table class="reg" style="margin-top:1rem">
        <tbody>{sameName.map((q) => (
          <tr>
            <td><a href={u("/people/" + q.slug)}>{q.name}</a></td>
            <td class="mono dim">{q.born || "?"}{q.died ? "–" + q.died : ""}</td>
            <td class="dim">{q.bornPlace ? q.bornPlace.split(",")[0] : "place not recorded"}</td>
            <td class="dim">{(evidence[q.slug] || {}).ahn
              ? <span class="tag">direct line</span> : ""}</td>
          </tr>))}</tbody>
      </table>
      <p class="dek" style="margin-top:1rem">Same name, and nothing here says they are related.
