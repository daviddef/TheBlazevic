{
  "name": "blazevic-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4324",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run atlas && astro build && npm run sitemap && npm run check:living && npm run check:kit && npm run check:worklist && npm run check:covers && npm run check:found && npm run check:holdings && npm run check:dates && npm run check:stamp",
    "preview": "astro preview --port 4324",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --data src/data --policy named-bare",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:found": "python3 ../tools/foundcheck.py --quiet",
    "check:holdings": "python3 ../tools/holdingscheck.py --quiet",
    "check:dates": "python3 ../tools/datecheck.py --quiet",
    "check:stamp": "python3 ../tools/regen.py --check"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#a81c2eae8c40c55c21c7dc43e7d4ede7fbe23264",
    "astro": "^5.18.2"
  }
}
