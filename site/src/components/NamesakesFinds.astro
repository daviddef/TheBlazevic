---
/* The kit's Namesakes list (one name, everyone who bore it), for a name page that also lists people READ OUT OF A REGISTER
 * and not in the family tree: a find whose name field is a name and who is certainly dead (src/data/who-finds.json,
 * written by tools/names_index.py). The kit's component links every entry to /people/<slug>/; a find has a page of its
 * own at /found/<slug>/, so this one takes the address with the entry. Used only for a name that has such a find; every
 * other name page still uses the kit's Namesakes, unchanged. Its styles are inline attributes: a <style> block or a rule in
 * styles.css would change every one of the 3,600 /who/ pages (a block is inlined into each page that imports this component;
 * the stylesheet's cache-busting version changes every page of the site).
 */
const { name, people = [], finds = [], base = "" } = Astro.props;
const root = base.replace(/\/$/, "");
const all = [
  ...people.map((p) => ({ href: `${root}/people/${p.slug}/`, name: p.name, life: p.life || "no dates recorded", where: p.where })),
  ...finds.map((f) => ({ href: `${root}/found/${f.slug}/`, name: f.name, life: f.date || "no date recorded", where: f.place,
                         note: "Read out of a register; not in the family tree" })),
];
const many = all.length > 1;
---
<div>
  <p style="font-size:17px;line-height:1.6;color:var(--ink-2)">
    {many
      ? <><strong>{all.length} different people</strong> in this archive were called {name}.
          They are not the same person, and telling them apart is what this page is for.</>
      : <>One person in this archive was called {name}.</>}
  </p>

  <ol style="list-style:none;margin:20px 0 0;padding:0;display:flex;flex-direction:column;gap:10px">
    {all.map(p => (
      <li style="border-left:3px solid var(--rule-strong);padding:8px 0 8px 14px">
        <a href={p.href} style="font-family:var(--serif);font-size:19px;color:var(--accent)">{p.name}</a>
        <span style="display:block;font-family:var(--mono);font-size:12px;color:var(--ink-2);margin-top:3px">{p.life}</span>
        {p.where && <span style="display:block;font-size:13.5px;color:var(--ink-3);margin-top:2px">{p.where}</span>}
        {p.note && <span style="display:block;font-size:13px;color:var(--ink-3);margin-top:4px;font-style:italic">{p.note}</span>}
      </li>
    ))}
  </ol>

  {many && (
    <p style="margin-top:18px;font-size:14px;color:var(--ink-3);border-left:2px solid var(--ochre);padding-left:12px">Where two of these have no dates, this archive cannot presently tell you
    which is which either. That is a gap, not a tidy answer.</p>
  )}
</div>
