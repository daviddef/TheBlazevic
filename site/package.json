{
  "name": "blazevic-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4324",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run check:pin && npm run check:repo && npm run check:records && npm run atlas && astro build && npm run autolink && npm run sitemap && npm run check:book && npm run check:living && npm run check:living-standard && npm run check:living-years && npm run check:prose:build && npm run check:kin && npm run check:templates && npm run check:kit && npm run check:worklist && npm run check:covers && npm run check:found && npm run check:snapshots && npm run check:numbers && npm run check:holdings && npm run check:dates && npm run check:stamp && npm run check:pages && npm run check:familypages && npm run check:alsoin && npm run check:inline && npm run check:rows && npm run check:datalinks && npm run check:notes && npm run check:household && npm run check:nav && npm run check:lines && npm run check:links && npm run check:story && npm run check:directline && npm run check:familyribbon && npm run check:rec && npm run check:standard && npm run check:era-ground && npm run check:era && npm run check:era:selftest",
    "preview": "astro preview --port 4324",
    "autolink": "python3 ../tools/autolink_run.py",
    "check:links": "python3 ../tools/autolink_run.py --gate",
    "check:standard": "python3 ../tools/standard_run.py",
    "check:records": "python3 ../tools/build_records.py --check",
    "check:rec": "python3 ../tools/check_rec.py --sample 100",
    "check:story": "python3 ../tools/story_living.py && python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilystory.py --story src/data/story.json --dist \"${ARCHIVE_OUT:-dist}\" --person-base /people/ --living ../../private/blazevic/story-living.json --strict && python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilystory.py --selftest",
    "check:directline": "python3 node_modules/@daviddef/archive-kit/kit/tools/directline.py --story src/data/story.json --check src/data/direct-line.json && python3 ../tools/family_ribbon.py --check",
    "check:familyribbon": "python3 ../tools/story_living.py && python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilyribbon.py --families src/data/family-lines.json --direct src/data/direct-line.json --story src/data/story.json --dist \"${ARCHIVE_OUT:-dist}\" --lines src/data/lines.json --living ../../private/blazevic/story-living.json --strict && python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilyribbon.py --selftest",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "check:book": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkbook.py --dist dist --book src/data/book.json",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist \"${ARCHIVE_OUT:-dist}\"",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist \"${ARCHIVE_OUT:-dist}\" --data src/data --policy named-bare --years --config standard.json --strict-allow",
    "check:living-standard": "python3 ../tools/livingcheck.py --selftest",
    "check:living-years": "python3 ../tools/livingyears.py --selftest",
    "check:prose": "python3 ../tools/prosecheck.py",
    "check:prose:build": "python3 ../tools/prosecheck.py --selftest && python3 ../tools/prosecheck.py --not-run-ok",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:found": "python3 ../tools/foundcheck.py --quiet",
    "check:holdings": "python3 ../tools/holdingscheck.py --quiet",
    "check:dates": "python3 ../tools/datecheck.py --quiet",
    "check:stamp": "python3 ../tools/regen.py --check",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root .",
    "check:pages": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpages.py --root . --estate ../.. --max-bespoke 2",
    "check:pin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpin.py --root .",
    "check:familypages": "python3 ../tools/familycheck.py --selftest && python3 ../tools/familycheck.py --dist \"${ARCHIVE_OUT:-dist}\"",
    "check:alsoin": "python3 ../tools/check_also_in.py --selftest && python3 ../tools/check_also_in.py",
    "check:nav": "python3 node_modules/@daviddef/archive-kit/kit/tools/checknav.py --dist dist --strict",
    "check:lines": "python3 ../tools/living_slugs.py && python3 node_modules/@daviddef/archive-kit/kit/tools/checklines.py --lines src/data/lines.json --dist \"${ARCHIVE_OUT:-dist}\" --config standard.json --living ../../private/blazevic/living-slugs.json && python3 node_modules/@daviddef/archive-kit/kit/tools/checklines.py --selftest",
    "check:inline": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkinline.py --root . --max-inline 3",
    "check:rows": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkrows.py --root .",
    "check:numbers": "python3 ../tools/numbercheck.py",
    "check:repo": "python3 ../tools/repocheck.py",
    "check:kin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkkin.py --data src/data/people.json --born born --died died --max 6",
    "check:datalinks": "python3 ../tools/datalinks.py",
    "check:notes": "python3 ../tools/notescheck.py",
    "check:household": "python3 ../tools/householdcheck.py",
    "check:snapshots": "python3 ../tools/snapshots.py",
    "check:era-ground": "python3 ../tools/build_era.py --check",
    "check:era": "python3 ../tools/build_era.py --living-urls && python3 node_modules/@daviddef/archive-kit/kit/tools/checkera.py --dist \"${ARCHIVE_OUT:-dist}\" --snapshot src/data/era-snapshot.json --living-urls ../../private/blazevic/era-living.json --require-tracked",
    "check:era:selftest": "python3 node_modules/@daviddef/archive-kit/kit/tools/era_selftest.py"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#d88b11e914e433d9d2c6bd750b8d8e707d1a0b65",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
