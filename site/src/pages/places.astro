---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import places from "../data/places.json";
const key = [
  ["Senj", "The port town. Birthplace of Hedviga, Milka and Josip Papić; deathplace of Toma Blažević, Ljubomir, Milka and Antonija. Everything converges here.", "/senj"],
  ["Smokvica Krmpotska", "The Blažević village in the Vinodol hills, settled by Bunjevci in the 17th century. House 114 is Toma's.", "/bunjevci"],
  ["Krivi Put", "The Prpić village on the Senj mountain. House 136 produced 35 people in this tree.", "/bunjevci"],
  ["Otočac", "The Žubrinić town, in the Gacka valley in Lika, inland across the Velebit.", "/zubrinic"],
  ["Selce", "On the Vinodol coast — the Antić–Papić and Jelličić lines.", "/papic"],
  ["Karlobag", "South down the coast under the Velebit — the Pilipić, Uroda, Smojver and Gerkacs lines, and the archive's deepest generation.", null],
  ["Klenovica & Povile", "The Kalanj villages, on the coast between Novi Vinodolski and Senj.", null],
  ["Port Pirie", "South Australia. The Žubrinić emigration of about 1884, and the Zubrinich spelling.", "/port-pirie"],
];
---
<Base title="Places"
  eyebrow="A hundred kilometres of coast, and then two other continents"
  dek="With one exception, every place in this archive before 1884 lies within a day's walk of the Velebit — and the exception is the whole point.">

  <section class="blk">
    <div class="grid two">
      {key.map(([n, d, href]) => (
        <div class="card">
          <h3>{href ? <a href={u(href)}>{n}</a> : n}</h3>
          <p>{d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="blk">
    <h2>Every place, counted</h2>
    <p class="dek">Every place is a link: it opens the register filtered to the people recorded
    there. Births and deaths of published people carrying one of the eight surnames. Spelling
    variants are collapsed where they are literally the same place; nothing distinct is merged.
    House numbers are kept, because in Frontier registers the house number <em>is</em> the
    family.</p>
    <table class="reg">
      <thead><tr><th>Place</th><th>People</th></tr></thead>
      <tbody>{places.map((p) => (
        <tr>
          <td><a href={u(`/people/?q=${encodeURIComponent(p.place.split(",")[0])}`)}>{p.place}</a></td>
          <td class="mono">{p.n}</td>
        </tr>))}</tbody>
    </table>
  </section>
  <section class="blk">
    <div class="lab">Data quality</div>
    <h2>Three places in this archive are geocoded wrong</h2>
    <p class="lede">Not misread, and not disputed — <strong>machine-matched to the wrong town</strong>.
    A geocoder given a village name picks a candidate, and twice here it picked one hundreds of
    kilometres away. They are corrected on the people concerned rather than left standing, because
    unlike a contested reading there is nothing here to reproduce: no human ever claimed it.</p>
    <table class="reg">
      <thead><tr><th>Where the tree puts it</th><th>Where it is</th><th>How far wrong</th></tr></thead>
      <tbody>
        <tr><td class="mono">Smokvica, Općina Smokvica,<br />Dubrovačko-neretvanska</td>
          <td><strong>Smokvica Krmpotska</strong>, Novi Vinodolski,<br />Primorje-Gorski Kotar</td>
          <td><strong>400 km</strong> — the wrong Smokvica is on <strong>Korčula</strong>. The
            tree's own string says <em>Krmpote</em> in the same breath.</td></tr>
        <tr><td class="mono">Senj, Split-Dalmatia</td>
          <td><strong>Senj</strong>, Lika-Senj County</td>
          <td><strong>200 km</strong> — Senj was the seat of its own county and has never been in
            Split-Dalmatia.</td></tr>
        <tr><td class="mono">Osekovo, Belovár-Körös Megye,<br />Hungary</td>
          <td><strong>Otočac</strong>, Lika-Senj</td>
          <td>This one is <strong>FamilySearch's</strong>, not the tree's — a christening at Otočac
            catalogued under a different county entirely. Noted wherever the citation is reused.</td></tr>
      </tbody>
    </table>
    <p style="margin-top:1.2rem">The first matters most. <a href={u("/people/juraj-georgius-jure-blazevic")}>Juraj
    Blažević</a> is the man <a href={u("/open-questions")}>question 1b</a> is about, and
    <strong>Smokvica kbr. 114</strong> and the parish of <strong>sv. Jakov Krmpote</strong> are the
    whole of the argument. An archivist sent to Korčula would find nothing and conclude the family
    was not there.</p>
  </section>

</Base>
