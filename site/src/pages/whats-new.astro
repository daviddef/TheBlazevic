---
import Base from "../layouts/Base.astro";
import WhatsNew from "@daviddef/archive-kit/components/WhatsNew.astro";
import { pulse } from "../lib/pulse.js";
---
<Base
  title="What's new"
  eyebrow="Fresh from the workbench"
  dek="Here is what has been read and found in this archive lately, newest first. The full lines are on the What Has Been Read and Corrections pages."
