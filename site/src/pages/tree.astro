---
/* Our line, drawn.

   Nine generations, 70 people, and until now no picture of any of it. The data
   was always shaped for one: ancestors.json is an ahnentafel, a flat list
   numbered so the father of n is 2n, which is a tree written sideways.

   This archive is small enough to draw whole. No branch is cut for space, so
   every place the chart stops is a place the archive genuinely stops, and the
   wall list below is the real list of what is not known — not an artefact of
   how much would fit on the page. Six of the seven archives could not say that
   and this one can, which is worth the extra height. */
import Base from "../layouts/Base.astro";
import AncChart from "@daviddef/archive-kit/components/AncChart.astro";
import { ahnen } from "@daviddef/archive-kit/lib/ahnen.js";
import { u } from "../lib/url.js";
import ancestors from "../data/ancestors.json";
import W from "../data/walls.json";

/* The kit ends a branch with one sentence, printed once per wall: «no parents
   are recorded, and where the line goes next is not yet known». Thirty-one
   copies of it grade three different silences alike — a woman with no surname
   to search for, a woman wearing her husband's, and a properly identified man
   whose next document sits in a filmed register nobody has opened. Only the
   last is a worklist. tools/walls.py works out which each one is; this maps
   that onto the three colours the chart already has. */
const COLOUR = { reachable: "candidate", unchecked: "candidate",
                 nameless: "unknown", borrowed: "unknown", placeholder: "unknown" };

const root = ahnen(ancestors, {
  /* A source read, or the tree's word. Nothing in between, and the chart
     colours the difference rather than burying it. */
  conf: (r) => (r.sources && r.sources.length ? "doc" : "lore"),
  extra: (r) => ({ slug: r.slug }),
  wall: (r) => {
    const w = W.walls[String(r.ahn)];
    if (!w) return null;
    return { wall: true, kind: COLOUR[w.kind] || "unworked",
             label: w.label, note: w.note };
  },
});

const wc = W.counts;
const nameProblem = (wc.nameless || 0) + (wc.borrowed || 0) + (wc.placeholder || 0);
const actionable = (wc.reachable || 0) + (wc.unchecked || 0);

const personHref = (b) => (b.slug ? u(`/people/${b.slug}/`) : null);

let people = 0, doc = 0, walls = 0, deepest = 0;
(function count(x, g = 0) {
  if (!x) return;
  if (x.wall) { walls++; return; }
  people++; if (x.conf === "doc") doc++;
  if (g > deepest) deepest = g;
  count(x.f, g + 1); count(x.m, g + 1);
})(root);
---
<Base title="Our line, drawn"
      eyebrow={`${people} people, ${deepest + 1} generations, ${walls} walls`}
      dek="The whole of what this archive knows of Hedviga's ancestry, as one chart — nothing cut for space, so every place it stops is a place the line really stops.">

  <section class="blk">
    <p class="prose">The <a href={u("/direct-line/")}>spine</a> walks this line down in prose,
    generation by generation. This is the same line seen all at once, which answers a different
    question: not who came before whom, but how much of it is actually known.</p>

    <p class="prose">Of the <strong>{people}</strong> people here, <strong>{doc}</strong> rest on
    a record this archive has read. The other <strong>{people - doc}</strong> are the family
    tree's word and are drawn lighter — they may well be right, and none of them has been
    tested. <strong>{walls}</strong> branches simply end.</p>

    <p class="prose">Nothing is hidden for space. Where the chart stops, the archive stops, and
    <a href={u("/how-far-back/")}>How Far Back</a> sets out what each of those endings would
    take to get past.</p>

    <div class="qa" style="margin-top:1.4rem">
      <h3>Not every wall is the same kind of wall</h3>
      <p>The list under the chart used to say the same sentence about all
      <strong>{walls}</strong> of them — <em>no parents are recorded, and where the line goes next
      is not known.</em> That is true of all of them and useful about none of them, because they
      are not one thing.</p>
      <p style="margin-top:.6rem"><strong>{nameProblem} of the {walls} are name problems, not
      research problems.</strong> Seven are women the tree gives a given name and no surname at
      all; two more wear their husband's surname, which is the tree's convention and not a record
      of what they were born; two are a bare surname with no given name, which asserts only what
      the child's own name already says. <strong>There is nothing to search for</strong> until a
      marriage entry or a child's baptism supplies the missing half.</p>
      <p style="margin-top:.6rem"><strong>{wc.unplaced} more have no place recorded anywhere on
      the line</strong> — those walls are a place, not a name, and no register can be opened for
      them. <strong>{wc.outside}</strong> are properly identified people whose next document falls
      outside what is filmed; the notes say by how many years.</p>
      <p style="margin-top:.6rem"><strong>{actionable} are worth an afternoon.</strong> Four of
      them are at <a href={u("/searched/")}>Karlobag</a>, the best-read parish here, whose film
      ranges have never once been checked — so whether the next step is reachable is not known,
      and finding out costs nothing but the sitting.</p>
    </div>
  </section>

  <AncChart root={root} personHref={personHref} />

  <section class="blk">
    <p class="prose dim">The families this line marries into are on <a href={u("/trees/")}>the
    trees</a>. Hedviga has <a href={u("/hedviga/")}>a page of her own</a>, and so does
    <a href={u("/milka/")}>her mother</a>.</p>
  </section>
</Base>
