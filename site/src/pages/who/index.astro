---
/* Every name in the archive, and how many people bore it. */
import Base from "../../layouts/Base.astro";
import NameLists from "@daviddef/archive-kit/components/NameLists.astro";
import EveryName from "@daviddef/archive-kit/components/EveryName.astro";
import { u } from "../../lib/url.js";
import people from "../../data/people.json";
import living from "../../data/living.json";

function slugify(s) {
  return String(s ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^A-Za-z0-9]+/g, "-").replace(/^-+|-+$/g, "").toLowerCase();
}

const by = new Map();
for (const p of people) {
  if (!p.name) continue;
  const k = slugify(p.name);
  if (!k) continue;
  if (!by.has(k)) by.set(k, { name: p.name, n: 0 });
  by.get(k).n += 1;
}
/* A living person is counted under a name that somebody who has died also bore.
   A name borne ONLY by the living is not listed here: its page is kept out of
   search engines, and an index that anyone can crawl is the wrong place for it. */
for (const p of living) {
  const k = slugify(p.name);
  if (by.has(k)) by.get(k).n += 1;
}
const names = [...by.entries()].map(([slug, v]) => ({ slug, ...v }))
  .sort((a, b) => b.n - a.n || a.name.localeCompare(b.name));
const shared = names.filter(n => n.n > 1);
---
<Base title="Every Name"
      eyebrow={`${names.length} names · ${shared.length} held by more than one person`}
      dek="A name is not a person. This is every name in the archive, and how many different people bore it.">

<NameLists here="who" u={u} />


  <section class="blk">
    <EveryName names={names} u={u} />
  </section>
</Base>
