---
import Base from "../../../layouts/Base.astro";
import ResearchList from "../../../components/ResearchList.astro";
import { u } from "../../../lib/url.js";
import { RESEARCH } from "../../../lib/research-menu.js";
const g = RESEARCH.find((x) => x.id === "to-do");
const rest = RESEARCH.filter((x) => x.id !== "to-do");
---
<Base title="To do" eyebrow="Research · what is not done yet" dek={g.dek}>
  <section class="blk">
    <ResearchList items={g.items.filter((x) => !x.sub)} />
    {g.items.filter((x) => x.sub).map((s) => (
      <>
        <h2 id={s.id} class="rs-sub2">{s.sub}</h2>
        <p class="cap">{s.note}</p>
        <ResearchList items={s.items} />
      </>
    ))}
    <p class="cap rs-rest">The rest of Research: {rest.map((x, i) => (<>{i ? " · " : ""}<a href={u(x.href)}>{x.head}</a></>))} · <a href={u("/research/")}>all of it on one page</a>.</p>
  </section>
</Base>
