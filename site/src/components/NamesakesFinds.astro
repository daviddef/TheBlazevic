---
/* The kit's Namesakes list (one name, everyone who bore it), for a name page that also lists people READ OUT OF A REGISTER
 * and not in the family tree: a find whose name field is a name and who is certainly dead (src/data/who-finds.json,
 * written by tools/names_index.py). The kit's component links every entry to /people/<slug>/; a find has a page of its
 * own at /found/<slug>/, so this one takes the address with the entry. Used only for a name that has such a find; every
 * other name page still uses the kit's Namesakes, unchanged.
 */
const { name, people = [], finds = [], base = "" } = Astro.props;
const root = base.replace(/\/$/, "");
const all = [
  ...people.map((p) => ({ href: `${root}/people/${p.slug}/`, name: p.name, life: p.life || "no dates recorded", where: p.where })),
  ...finds.map((f) => ({ href: `${root}/found/${f.slug}/`, name: f.name, life: f.date || "no date recorded", where: f.place,
                         note: "Read out of a register; not in the family tree" })),
];
const many = all.length > 1;
---
<div class="nsk">
  <p class="nsk-lede">
    {many
      ? <><strong>{all.length} different people</strong> in this archive were called {name}.
          They are not the same person, and telling them apart is what this page is for.</>
      : <>One person in this archive was called {name}.</>}
  </p>

  <ol class="nsk-list">
    {all.map(p => (
      <li>
        <a href={p.href}>{p.name}</a>
        <span class="nsk-life">{p.life}</span>
        {p.where && <span class="nsk-where">{p.where}</span>}
        {p.note && <span class="nsk-note">{p.note}</span>}
      </li>
    ))}
  </ol>

  {many && (
    <p class="nsk-warn">Where two of these have no dates, this archive cannot presently tell you
    which is which either. That is a gap, not a tidy answer.</p>
  )}
</div>

<style>
  .nsk-lede { font-size: 17px; line-height: 1.6; color: var(--ink-2); }
  .nsk-list { list-style: none; margin: 20px 0 0; padding: 0;
              display: flex; flex-direction: column; gap: 10px; }
  .nsk-list li { border-left: 3px solid var(--rule-strong); padding: 8px 0 8px 14px; }
  .nsk-list a { font-family: var(--serif); font-size: 19px; text-decoration: none; color: var(--accent); }
  .nsk-list a:hover { text-decoration: underline; }
  .nsk-life { display: block; font-family: var(--mono); font-size: 12px; color: var(--ink-2); margin-top: 3px; }
  .nsk-where { display: block; font-size: 13.5px; color: var(--ink-3); margin-top: 2px; }
  .nsk-note { display: block; font-size: 13px; color: var(--ink-3); margin-top: 4px; font-style: italic; }
  .nsk-warn { margin-top: 18px; font-size: 14px; color: var(--ink-3);
              border-left: 2px solid var(--ochre); padding-left: 12px; }
</style>
