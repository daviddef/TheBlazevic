---
import Base from "../layouts/Base.astro";
import BranchRivers from "@daviddef/archive-kit/components/BranchRivers.astro";
import { u } from "../lib/url.js";
import lines from "../data/lines.json";
import { md, plain } from "@daviddef/archive-kit/lib/md.js";

/* 11 October 2026. THE PAGE LOOPS OVER lines.sets NOW: Uroda was the first, and the
   Karlobag mother-side surnames follow it as further sets in the same file.

   First version, 11 October 2026. Asked for by David after seeing Defranceski's «Six families,
   one surname»: did this archive have a picture like that? It had none, and
   Uroda is the surname that needed it — three groups at Karlobag, a dead man of
   Šibenik, and two Dalmatian families of the index all answer to the one name,
   and a reader (or this archive) who met «Dume Uroda» twice would have merged
   them.

   The drawing is the kit's BranchRivers, which three archives had already
   drawn by hand. The unplaced and loose footers are passed empty and listed
   below the figure instead, with a sentence and a link each, which is more than
   the figure can hold and keeps them on the page. WHAT IS THIS ARCHIVE'S ALONE
   is the data, and the rule: a lane is a family the registers show, a dotted
   bridge is a join no document makes, and nothing is merged until one does. */
const sets = lines.sets;
/* The drawing shows each reason as plain text in a tooltip, so the **bold** and «quote»
   markers are taken out for it; the lists below the figure render them. */
const forDrawing = (set) => ({
  ...set, unplaced: [], loose: [],
  lanes: set.lanes.map((l) => ({
    ...l,
    nodes: l.nodes.map((n) => [n[0], n[1], plain(n[2]), ...n.slice(3)]),
    ends: (l.ends || []).map((e) => [e[0], e[1], plain(e[2]), ...e.slice(3)]),
  })),
});
const snap = (id) => u(`/snapshots/#${id}`);
---
<Base title="The Lines of a Name"
      eyebrow={`${sets.length} surnames kept in separate lanes`}
      dek="A surname is not a family. Wherever the registers show several households of one name, each gets a lane of its own, and a join between lanes is drawn dotted until a document makes it.">

  <section class="blk">
    <p class="lede">
      They are not one family, and nothing read so far says they were. A name like <em>Uroda</em> or
      <em>Smojver</em> turns up in three households at one town, in a dead man «of Šibenik», in a
      soldier's household at Drniš. <strong>So each gets a lane of its own.</strong> What is
      documented goes on the lane; a join between lanes is drawn dotted and says what it rests on;
      nothing is merged until a register joins it.
    </p>
    <p class="dim">{sets.map((s, i) => (<>{i ? " · " : ""}<a href={`#${s.slug}`}>{s.name}</a></>))}</p>
  </section>

  {sets.map((set) => (
    <section class="blk" id={set.slug}>
      <div class="lab">{set.eyebrow}</div>
      <h2>{set.name}</h2>
      <p class="dim">{set.dek}</p>

      <figure class="rivers">
        <BranchRivers rivers={forDrawing(set)} caption="" />
        <figcaption>
          Hover or tab any dot and it says what the register behind it says; click again to go there.
          <strong>The top lane is the one this archive descends from.</strong> The dotted curves are
          candidate joins between lanes, on evidence short of a document — questions, not findings. A
          dotted end-point is a hope, not a link.
        </figcaption>
      </figure>

      {set.note && <div class="note" set:html={set.note.replaceAll("{{base}}", u("/").replace(/\/$/, ""))} />}

      <h3 style="margin-top:1.6rem">What each line stands on</h3>
      {set.lanes.map((l) => (
        <div class="qa" id={`${set.slug}-${l.key}`} style="margin:1.3rem 0">
          <h3 style={`color:${l.colour}`}>{l.label}</h3>
          <p class="dim mono" style="font-size:.78rem">{l.conf}</p>
          <ol style="margin:.5rem 0 0;padding-left:1.2rem">
            {l.nodes.map(([place, year, why]) => (
              <li style="margin:.35rem 0"><strong>{place}</strong> · <span class="mono">{year}</span> — <Fragment set:html={md(why)} /></li>
            ))}
          </ol>
          {set.sources?.[l.key]?.length > 0 && (
            <p style="margin-top:.7rem">The pages themselves:
              {set.sources[l.key].map(([label, id], i) => (
                <>{i ? " · " : " "}<a href={snap(id)}>{label}</a></>
              ))}
            </p>
          )}
          {l.ends.map(([e, , why]) => (
            <p class="dim" style="margin:.4rem 0 0">→ <strong>{e}</strong>: <Fragment set:html={md(why)} /></p>
          ))}
        </div>
      ))}

      {set.unplaced?.length > 0 && (<>
        <h3>Households of the name, not yet on any lane</h3>
        <ul style="padding-left:1.1rem">
          {set.unplaced.map(([name, href, why]) => (
            <li style="margin:.4rem 0"><a href={u(href)}><strong>{name}</strong></a> — {why}</li>
          ))}
        </ul>
      </>)}
      {set.loose?.length > 0 && (<>
        <h3 style="margin-top:1.4rem">Attached to no line here</h3>
        <ul style="padding-left:1.1rem">
          {set.loose.map(([name, href, why]) => (
            <li style="margin:.4rem 0"><a href={u(href)}><strong>{name}</strong></a> — {why}</li>
          ))}
        </ul>
      </>)}
      {set.owes && <div class="note" style="margin-top:1.4rem"><strong>What this name still owes.</strong> <Fragment set:html={set.owes} /></div>}
    </section>
  ))}

  <section class="blk">
    <div class="note"><strong>What each lane owes.</strong> A lane carries three things: what is
    documented, what is inferred, and <em>what would have to be found to join it to another</em>.
    The full list is on <a href={u("/worklist/")}>the work list</a>. A surname with no second
    family yet — <strong>Gerkacs</strong> at Karlobag, <strong>Luckinić</strong> — gets a lane the
    day a second family of the name is met, not before.</div>
  </section>

</Base>

<style is:global>
  /* The kit draws its two footers («real households not yet placed», «a different
     stock of a very common name», and a hard-coded note about the commonest patronymic
     in Italy) even when both lists are empty. This page lists them in prose under the
     figure, so the empty footer group — always the last child of the svg — is hidden. */
  .rivers svg > g:last-child { display: none; }
</style>
