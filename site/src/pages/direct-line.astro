---
import Base from "../layouts/Base.astro";
import Spine from "@daviddef/archive-kit/components/Spine.astro";
import { u } from "../lib/url.js";
import line from "../data/line.json";
import ancestors from "../data/ancestors.json";
import register from "../data/people.json";

const byGen = {};
for (const a of ancestors) (byGen[a.gen] ||= []).push(a);
const gens = Object.keys(byGen).map(Number).sort((a, b) => a - b);
const sourced = line.filter((p) => p.sources && p.sources.length).length;

/* THE SPINE WAS DRAWING A THIRD OF WHAT THIS ARCHIVE HOLDS ABOUT THESE
   EIGHT MEN. It passed a name, a birth year, a birthplace, a death year
   and the occupations stuffed into `note` as a dim span — and dropped the
   wives, the deathplaces, the sources it counts in its own footnote, and
   the brothers and sisters.

   None of that needed finding. people.json carries `rel.spouses` and
   `rel.siblings` for every one of them; line.json carries diedPlace,
   occupations and sources. The row has accepted all of it since it was
   written.

   The siblings matter here more than in most archives. Generation two's
   sister is Anka Blažević, and /kosina/ is a whole page about what
   happened to her household — a page that could not be reached from the
   spine it belongs to. */
const REL = new Map(register.map((r) => [r.id, r.rel || {}]));
const spineRows = line.map((p) => {
  const rel = REL.get(p.id) || {};
  const sibs = rel.siblings || [];
  return {
    gen: p.gen,
    name: p.name,
    href: `/people/${p.slug}/`,
    spouse: ((rel.spouses || [])[0] || {}).name || "",
    born: p.byear || "", bornPlace: p.bornPlace || "",
    died: p.dyear || "", diedPlace: p.diedPlace || "",
    trade: (p.occupations || []).map((o) => o.what).filter(Boolean).join(" · "),
    household: sibs.length
      ? { label: sibs.length === 1 ? "His sister or brother" : "Brothers and sisters",
          members: sibs.map((x) => ({
            name: x.name,
            // The archive's own slug, never one built from the name here.
            href: x.slug ? `/people/${x.slug}/` : null,
            dates: [x.born, x.died].filter(Boolean).join("\u2013") || "",
          })) }
      : null,
    // The footnote under this spine counts these; the rows never showed
    // them. A source string here is most often another online tree, which
    // is the archive's own point and is worth being able to see per row.
    sources: (p.sources || []).map((x) => ({ label: String(x).split(" \u2014 ")[0] })),
    weak: p.gen === 3 || !(p.sources && p.sources.length),
    weakNote: p.gen === 3
      ? "Still no birth or death date — but no longer undocumented: the 1920 marriage register names him as Ljubomir's father."
      : "No source of any kind attached.",
  };
});
---
<Base title="The Spine"
  eyebrow={`${line.length} generations of Blažević men`}
  dek="From Hedviga at Senj in 1926 back to a boy born about 1750 in a village barely a century old. This is the line the tree asserts — with the joint that cannot yet bear weight marked as such.">

  <section class="blk">
    <Spine u={u} rows={spineRows} />
    <p class="note"><strong>{sourced} of {line.length}</strong> generations on this spine carry a
    source string in the tree; <strong>{line.length - sourced}</strong> carry none. And a source
    string here most often means another online tree.
    <a href={u("/method/")}>Why that matters →</a></p>
  </section>

  <section class="blk">
    <div class="lab">Corrected, September 2026</div>
    <h2>The join at generation three</h2>
    <p class="lede">This section used to say that everything above
    <a href={u("/people/ljubomir-blazevic/")}>Ljubomir</a> hung on a man with
    <strong>no document at all</strong>. That was wrong. The
    <a href={u("/marriage-1920/")}><strong>Senj marriage register of 8 December 1920</strong></a>
    names the groom's parents outright — <strong>Juraj Blažević and Tereza <em>r.</em>
    Žubrinić</strong> — and it had been attached in the family tree the whole time, invisible
    because media does not travel in a GEDCOM export.</p>
    <p>So the link from Ljubomir to Juraj is <strong>documented</strong>, by a priest writing in
    1920 with the couple in front of him. It is corroborated from below, too: Ljubomir was born at
    <strong>Rijeka on 1 March 1892</strong> — the register confirms that date — while his siblings
    Anka (1893) and Ruža (1897) are recorded at <strong>Otočac</strong> and <strong>Smokvica
    Krmpotska</strong>, the mother's town and the father's village.</p>
    <div class="note"><strong>The wall moved up one generation; it did not fall.</strong> Juraj is
    now named by a record, but he is still <em>undated and unplaced</em>, and nothing yet connects
    him to <a href={u("/people/toma-tomislav-blazevic/")}>Toma</a> at generation four. The register
    also annotates him <em>mrt.</em> — deceased — which puts his death <strong>before December
    1920</strong>. <a href={u("/open-questions/")}>Open questions →</a></div>
  </section>

  <section class="blk">
    <div class="lab">Where the depth actually is</div>
    <h2>Nine generations, seventy people</h2>
    <p>The male Blažević spine is eight deep, but the tree's real reach is on the
    <strong>mothers' sides</strong> — the Pilipić and Uroda lines out of
    <strong>Karlobag</strong>, and the Antić–Jelličić lines out of <strong>Selce</strong>, both of
    which run to a ninth generation and into the <strong>1710s and 1720s</strong>.</p>

    <div class="qa" style="margin-top:1.4rem">
      <div class="lab">Added 14 September 2026 · the Karlobag films</div>
      <h3>The Karlobag side stopped being a list of names</h3>
      <p><strong>Ahnentafel 13 has brothers and sisters.</strong> The Karlobag household census, read
      for the first time, puts her in a house of seven: <em>«Pilepich Vicko, 17 Nov. 805 · Matia ux.,
      23 April 810 · Joso f., 14 Oct. 835 · <strong>Matia f., 18 Sept. 838</strong> · Vice f.,
      16 Febr. 847 · Jure f. · Maria Jurka f., 24 lipnja 852»</em>. Three of those dates are
      <a href={u("/tree/")}>ahnentafel 26, 27 and 13</a> and all three agree with the tree to the
      day. <strong>Four are new, and this archive had no siblings for her at all.</strong></p>
      <p style="margin-top:.7rem"><strong>Ahnentafel 55 has a death and her husband a trade.</strong>
      The Karlobag death register, folio 52: <em>«Maria uxor <strong>piscatoris</strong> Georgii
      Uroda annorum 45»</em>, 6 August 1834 — the tree's date and the tree's age, exactly. The word
      <em>uxor</em> rather than <em>vidua</em> proves <strong>ahnentafel 54 was alive that day</strong>,
      which killed two candidate deaths for him in one stroke. He is a <strong>fisherman</strong>,
      which nothing here knew an hour before.</p>
      <p style="margin-top:.7rem"><strong>And four walls on this line turned from «not known» into
      «go and read it».</strong> The Karlobag films were range-checked the same day: births from the
      1690s, marriages from 1736, deaths from 1774. Jacob Pilipić, Georgi Uroda, Vicentius Luckinić
      and <strong>Josiph Smojver Vukić's own baptism of 1731</strong> all fall inside them.
      <a href={u("/karlobag/")}>Karlobag →</a></p>
    </div>
    {gens.map((g) => (
      <div class="genblk">
        <h3>Generation {g} <span class="dim">— {byGen[g].length} {byGen[g].length === 1 ? "person" : "people"}</span></h3>
        <ul class="cols">
          {byGen[g].sort((a, b) => a.ahn - b.ahn).map((p) => (
            <li><span class="mono dim">{p.ahn}</span>
              <a href={u(`/people/${p.slug}/`)}>{p.name}</a>
              <span class="yrs">{p.byear || "?"}–{p.dyear || "?"}</span></li>
          ))}
        </ul>
      </div>
    ))}
    <p class="dek">Numbered by <strong>Ahnentafel</strong>: Hedviga is 1, her father 2, her mother
    3, and every person's father is twice their number. A missing number is a missing ancestor, which
    is the point of using it.</p>
  </section>
</Base>
