---
/* One page per NAME. /people/<person> is one human; this is everyone who bore
   the name, and the two link to each other. */
import Base from "../../layouts/Base.astro";
import Namesakes from "@daviddef/archive-kit/components/Namesakes.astro";
import { u } from "../../lib/url.js";
import people from "../../data/people.json";
import living from "../../data/living.json";
import whoFinds from "../../data/who-finds.json";
import NamesakesFinds from "../../components/NamesakesFinds.astro";

export function getStaticPaths() {
  const slugify = (s) => String(s ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^A-Za-z0-9]+/g, "-").replace(/^-+|-+$/g, "").toLowerCase();
  const by = new Map();
  /* THE LIVING ARE BEARERS OF A NAME TOO. A name page whose every bearer is
     living is noindex (and carries no canonical, because there is nothing
     else to point at); a page with at least one person who has died stays
     as it was and lists the living bearers by name, town and country. */
  for (const p of [...people, ...living]) {
    if (!p.name || !p.slug) continue;
    const k = slugify(p.name);
    if (!k) continue;           // a name with no letters or digits has no name page
    if (!by.has(k)) by.set(k, { name: p.name, rows: [] });
    by.get(k).rows.push(p);
  }
  /* The finds listed under a name (src/data/who-finds.json, written by tools/names_index.py): people read out of a register
     whose name field IS a name and who are certainly dead. They are listed for a name that is a page already; a name
     borne only by finds gets no page. */
  return [...by.entries()].map(([slug, v]) =>
    ({ params: { slug }, props: { ...v, finds: whoFinds[slug] || [], allLiving: v.rows.every((r) => r.living) } }));
}

const { name, rows, finds, allLiving } = Astro.props;
const listed = rows.map(p => p.living ? ({
  name: p.name, slug: p.slug,
  life: "living — named only",
  where: [p.town, p.country].filter(Boolean).join(", "),
}) : ({
  name: p.name, slug: p.slug,
  life: [p.born, p.died].filter(Boolean).join(" – "),
  where: p.bornPlace || p.diedPlace || "",
}));
---
<Base title={name} noindex={allLiving} noautolink={true}
      eyebrow={rows.length + finds.length > 1 ? `${rows.length + finds.length} people of this name` : "One person of this name"}
      dek={rows.length + finds.length > 1
        ? `${rows.length + finds.length} different people in this archive were called ${name}. This page tells them apart.`
        : `Everyone in this archive called ${name}.`}>
  <section class="blk">
    {finds.length
      ? <NamesakesFinds name={name} people={listed} finds={finds} base={u("/")} />
      : <Namesakes name={name} people={listed} base={u("/")} />}
    <p class="dek" style="margin-top:1.6rem">A name is not a person. Every entry above has its own
    page, because they are different people — see <a href={u("/method/#ladder")}>how this archive
    grades what it says</a>.</p>
  </section>
</Base>
