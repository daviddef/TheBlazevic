---
import Base from "../layouts/Base.astro";
import NameLists from "@daviddef/archive-kit/components/NameLists.astro";
import Register from "@daviddef/archive-kit/components/Register.astro";
import { u } from "../lib/url.js";
import register from "../data/register.json";
import nf from "../data/namefold.json";
/* THE REGISTER FOLDS TOO NOW. /people/ has folded spellings since it moved onto
   FilterTable - the box that makes zubrin find Zubrinic, Xubrinich and
   Zubrinich alike - and the register, which is the longer list and the one a
   researcher actually works from, did not. The map is this archive's own: the
   34 given-name groups it already keeps, plus the surname clusters namefold.py
   reads out of the corpus. Folding is a search rule and merges nothing. */

const groups = new Map();
for (const r of register) {
  if (!groups.has(r.group)) groups.set(r.group, []);
  groups.get(r.group).push(r);
}
const order = [...groups.keys()].sort(
  (a, b) => groups.get(b).length - groups.get(a).length || a.localeCompare(b));
const LABEL = {
  zubrinic: "Žubrinić", blazevic: "Blažević", papic: "Papić", prpic: "Prpić / Perpić",
  kalanj: "Kalanj", boras: "Boras", sestan: "Sestan", vukelic: "Vukelić",
};
const KIND = { tree: "family tree", swept: "read in the register" };
const swept = register.filter((r) => r.kind === "swept").length;
const tree = register.filter((r) => r.kind === "tree").length;
const linked = register.filter((r) => r.slug).length;
const surnames = order.length;
const pretty = (g) => LABEL[g] || (groups.get(g)[0].surname || g);
---
<Base title="The Register"
  eyebrow="Every named individual this archive has found"
  dek={`${register.length} entries across ${surnames} surnames — ${tree} carried by the family tree and ${swept} met while reading a register act by act. This is the raw catch, not a family tree, and a good deal of it is not this family — in the strict sense that two-thirds of the published people reach Hedviga only through a sorting label.`}>

<NameLists here="register" u={u} />



  <section class="blk">
    <div class="qa">
      <h3>Read this before you read the list</h3>
      <p>Entries marked <strong>family tree</strong> are the {tree.toLocaleString()} people this
      archive publishes from the family's MyHeritage tree. They are <strong>what the family
      believes</strong>, not what a record proves — and this archive has now shown several of them
      to be wrong, including <a href={u("/people/caetano-bacchi/")}>a man attached to his own
      grandson's generation</a>. Treat each as a claim until it appears on this page a second time
      with a register beside it. <a href={u("/impossible/")}>What cannot be true →</a></p>

      <p style="margin-top:.6rem">Entries marked <strong>read in the register</strong> are people
      met while reading the parish books act by act — <strong>godparents, witnesses, the
      officiating priest, the parents of the person marrying in, and the other brides on the
      page</strong>. A baptism names a priest and two godparents; a marriage names four parents,
      two witnesses and an officiant. Almost none of them are kin. <strong>They are here because
      they were found, not because they are family</strong>, and they are the part of the record a
      pedigree throws away.</p>

      <p style="margin-top:.6rem">Nothing here is invented. Where the register gives a trade, a
      rank or a house number it is recorded in the register's own words —
      <em class="mono">nadglednica u tvornici duhana</em>, <em class="mono">Vigiliarum Magister
      pensionatus</em>, <em class="mono">Poljice kbr. 38</em>. Where it gives nothing, the entry
      says nothing. The full readings are in the
      <a href="https://github.com/daviddef/TheBlazevic/tree/main/notes">reading logs</a>.</p>

      <p style="margin-top:.6rem">A shared surname is not a relationship. There are Blaževići on
      this page who are certainly no kin — it is the
      <a href={u("/name/")}>seventeenth commonest surname in Croatia</a>.</p>
    </div>
  </section>

  <section class="blk">
    <div class="finder">
      <Register u={u} fold={nf.fold} rows={[...groups.entries()].flatMap(([g, list]) => list.map((r) => ({
    name: r.name,
    surname: pretty(g),
    kind: KIND[r.kind] || r.kind,
    href: r.slug ? "/people/" + r.slug + "/" : "",
    chip: (r.kind === "swept" && !r.slug) ? "not in the tree" : "",
    detail: r.detail,
    source: r.source,
    sourceLabel: KIND[r.kind] || r.kind,
  })))} />
    </div>
  </section>

<style is:global>
  /* is:global, deliberately. A scoped <style> makes Astro stamp
     data-astro-cid-… onto every element the page renders, which on a register
     of thousands of rows adds more weight than the skipping saves. The
     selector below is specific to this page anyway. */
  /* 119 surname sections. Only the ones on screen need laying out; every row
     stays in the HTML for search engines and find-in-page. */
  section.sur {
    content-visibility: auto;
    /* Plain length first: browsers from Chrome 85 to 110 support
       content-visibility but cannot parse the "auto" keyword here, and
       without a usable estimate they collapse every off-screen section
       to nothing and the scrollbar jumps as you scroll. */
    contain-intrinsic-size: 320px;
    contain-intrinsic-size: auto 320px;
  }
</style>
</Base>
