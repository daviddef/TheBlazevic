---
import "@daviddef/archive-kit/styles/print.css";
import { versioner } from "@daviddef/archive-kit/lib/assetv.js";
/* every public asset gets a fingerprint, so a fix is never served stale */
const v = versioner();
import { u } from "../lib/url.js";
import SiblingArchives from "@daviddef/archive-kit/components/SiblingArchives.astro";
import SkipLink from "@daviddef/archive-kit/components/SkipLink.astro";
import SocialHead from "@daviddef/archive-kit/components/SocialHead.astro";
import JsonLd from "@daviddef/archive-kit/components/JsonLd.astro";
import VisitCount from "@daviddef/archive-kit/components/VisitCount.astro";
import ring from "@daviddef/archive-kit/data/archives.json";
/* THE BOOK (17 October 2026): every page of the site is a chapter of one book (src/data/book.json);
   the running head and the Previous / Next read the page's own path, so no page passes anything. */
import BookHead from "@daviddef/archive-kit/components/BookHead.astro";
import BookFoot from "@daviddef/archive-kit/components/BookFoot.astro";
import book from "../data/book.json";
/* noindex: <meta name="robots" content="noindex">, which also takes the page out
   of the sitemap (the kit's sitemap.py reads each built page).
   unstructured: no JSON-LD at all. A living person's page carries none, because
   structured data exists to be harvested.
   noautolink: the kit's build-time name linker (tools/names_index.py, kit autolink.py) leaves
   this page alone. true = the whole of <main>; "dek" = only the lead line under the title.
   Left alone, on purpose: a page that is itself a record (a person, a find, a name page) carries
   its own links in its own template, and its subject's name would be linked to the page it is on;
   and the pages that quote registers word for word (/snapshots/, /readings/, /register/,
   /searched/, every Snapshot figure), where a witness is a name in a transcription and a link would
   say he is the tree's man of that name. */
const { title, description = "", dek, eyebrow, bare, noindex, unstructured, noautolink } = Astro.props;
const SITE = "The Blažević Archive";
const nav = [
  ["Start", [["/", "Home"], ["/story/", "The Story"], ["/about/", "About"], ["/trees/", "The trees"], ["/tree", "Our line, drawn"], ["/atlas/", "The Atlas"], ["/timeline", "The Timeline"], ["/how-far-back", "How Far Back"]]],
  ["Our line", [["/direct-line", "The Spine"], ["/hedviga", "Hedviga"], ["/milka", "Milka, her mother"], ["/senj", "Senj"], ["/senj-1943", "Senj, 1943"], ["/oto", "The Brother"], ["/rhodes", "Rhodes"]]],
  ["The families", [["/connected", "Who They Married"], ["/lines", "Lines of a Name"], ["/blazevic", "Blažević"], ["/zubrinic", "Žubrinić"], ["/zubrinic-roots", "The Žubrinić Fragments"], ["/papic", "Papić"], ["/prpic", "Prpić"], ["/kalanj", "Kalanj"], ["/boras", "Boras"], ["/kosina/", "Kosina"], ["/vukelic", "Vukelić"], ["/sestan", "Šestan"], ["/pavelic", "Pavelić"], ["/tomljanovic", "Tomljanović"], ["/krmpotic", "Krmpotić"], ["/babic", "Babić"], ["/spalj", "Špalj"], ["/loncaric", "Lončarić"], ["/oreskovic", "Orešković"], ["/sekula", "Sekula"], ["/maric", "Marić"], ["/antic", "Antić"], ["/pilipic", "Pilipić"], ["/brozovic", "Brozović"], ["/jellicic", "Jelličić"], ["/uroda", "Uroda"], ["/luckinic", "Luckinić"], ["/gerkacs", "Gerkacs"], ["/smojver", "Smojver"], ["/families", "The Families"]]],
  ["Documents", [["/marriage-1920", "The Wedding of 1920"], ["/certificate", "The Certificate"], ["/grave", "The Grave"], ["/arolsen", "The Arolsen Cards"], ["/pictures", "The Pictures"], ["/faces", "The Faces"]]],
  ["Origins", [["/bunjevci", "The Bunjevci"], ["/frontier", "The Frontier"], ["/work", "What They Did"], ["/america", "The Other Emigration"], ["/gazetteer", "The Map"], ["/port-pirie", "Port Pirie"], ["/abroad/", "The Catch Abroad"]]],
  ["People & places", [["/people", "The People"], ["/bloodline/", "Blood relatives, drawn"], ["/who/", "Every Name"], ["/register", "The Register"], ["/places", "Places"], ["/marriages/", "The Marriages"]]],
  /* THE NAME IS ITS OWN GROUP NOW, AND ORIGINS IS ABOUT ORIGINS AGAIN.
     Say Your Name and The Second Name were filed under Origins, which holds
     the Bunjevci, the Frontier, what they did, the other emigration, the map
     and Port Pirie — a group about WHERE THE FAMILY CAME FROM. The two name
     pages were there because there was nowhere else to put them, and The Name
     itself was a third place, under Our line. Three archives in this estate
     already kept a group called The name between People & places and Evidence;
     this is that group. */
  ["The name", [["/name", "The Name"], ["/by-names", "The Second Name"], ["/your-name/", "Say Your Name"]]],
  ["Evidence", [["/method", "Method"], ["/sources", "Sources"], ["/searched", "What Has Been Read"], ["/open-questions", "Open Questions"], ["/errands/", "Errands"], ["/worklist/", "The work list"], ["/corrections/", "Corrections"], ["/changes/", "What changed"]]],
  ["Investigations", [["/harvest", "What Is Left to Read"], ["/readings/", "What the Registers Say"], ["/snapshots/", "The Pages Themselves"], ["/indexed/", "Which Books Are Indexed"], ["/coverage", "What Rests on a Document"], ["/impossible", "What Cannot Be True"], ["/duplicates", "The Same Person, Twice"], ["/buckets", "Labels Where the Father Should Be"], ["/found/", "Found Beside the Tree"], ["/stones/", "The Stones"], ["/hungarian-press/", "The Hungarian Press"]]],
];

const here = Astro.url.pathname.replace(/\/$/, "");
// Absolute URL for the sharing tags. Without these every page shared to a
// phone or a group chat renders as a bare grey link.
const share = dek || description ||
  "An evidence-first archive of Hedviga Blažević and the four families behind her.";
const on = (h) => here === u(h).replace(/\/$/, "");
/* which of the seven this is, worked out the same way the ring does.
   base alone is not unique any more: every archive on its own domain has base "",
   so find() returned the first of them (the Defranceschi entry) and VisitCount
   logged this archive's visits to thedefranceski.goatcounter.com. The origin
   settles it. This is inlined, the same logic as the kit's lib/ring.js whoami(),
   because a layout cannot import that file or the JSON bare (Node's ESM loader
   refuses a JSON import without an attribute outside Vite's resolution). */
const originOf = (x) => { try { return new URL(x).origin; } catch { return ""; } };
const SITE_ORIGIN = originOf(import.meta.env.SITE || "");
const onBase = ring.archives.filter(
  (a) => a.base === (import.meta.env.BASE_URL || "/").replace(/\/$/, "")
);
const thisArchive =
  (SITE_ORIGIN && onBase.find((a) => originOf(a.url) === SITE_ORIGIN)) || onBase[0];
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek || description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css") + v("styles.css")} />
<SocialHead title={title} description={share} site={SITE} image="photos/hero.jpg" />
{!unstructured && <JsonLd type={bare ? "WebSite" : "Article"} name={title} description={dek || description}
        url={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname}
        site={SITE} about={Astro.props.person} />}
{noindex && <meta name="robots" content="noindex" />}
</head>
<body class={bare ? "is-home" : ""}>
<SkipLink />
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Blažević <em>Archive</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={on(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/search/")}>Search</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={on(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}</div>
  </div>
</header>
<BookHead book={book} u={u} />

<main id="main" tabindex="-1" data-no-autolink={noautolink === true ? "" : undefined}>
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead" data-no-autolink={noautolink ? "" : undefined}>{dek}</p>}
      </div>
    )}
    <slot />
  </div>
</main>

<BookFoot book={book} u={u} />

<footer class="site">
  <div class="wrap">
    <SiblingArchives />
    <p class="foot">An evidence-first archive of the Blažević family of Senj and Smokvica Krmpotska —
    and of the Žubrinići of Otočac, the Papići of Selce and the Prpići of Krivi Put. Every claim
    carries its confidence, or is marked as unproven. <strong>A living person (80 or younger, with no death recorded) is named with their relationships and their town and country, and nothing more.</strong> Their pages are kept out of search engines.</p>
    <p class="foot dim">Built {new Date().getFullYear()} ·
      <a href={u("/sources/")}>Sources</a> ·
      <a href={u("/method/")}>Method</a> ·
      <a href={u("/open-questions/")}>Open questions</a> ·
      <a href={u("/corrections/")}>Corrections</a> ·
      Corrections are the most valuable thing you can send</p>
    <VisitCount code={thisArchive?.counter} />
  </div>
</footer>

<script is:inline>
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>
</body>
</html>
