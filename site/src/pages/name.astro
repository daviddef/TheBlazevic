---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import families from "../data/families.json";
import given from "../data/givennames.json";
import latin from "../data/latincases.json";
import surnames from "../data/surnames.json";
const sp = (s) => families.find((f) => f.slug === s);

const obs = Object.entries(given.observed)
  .map(([k, v]) => [k, v, Object.values(v).reduce((a, b) => a + b, 0)])
  .sort((a, b) => b[2] - a[2]);
const latAnc = latin.filter((l) => l.ancestor);
const vars4 = ["zubrinic", "blazevic", "papic", "prpic"]
  .map((k) => surnames.variants.find((v) => v.key === k)).filter(Boolean);
const unnamed = surnames.unnamed;
const crossed = surnames.crossed;
const latByName = {};
for (const l of latin) (latByName[l.nominative] ||= []).push(l);
const dist = [
  ["Blažević", "11,163", "1:652,830", "Croatia 7,216 (1:586) · Bosnia 3,058 · Serbia 492"],
  ["Papić", "6,014", "1:1,211,764", "Serbia 2,894 · Croatia 1,611 · Bosnia 1,165"],
  ["Prpić", "1,218", "1:5,983,207", "Croatia 1,071 (1:3,948) · Serbia 75 · Bosnia 55"],
  ["Žubrinić", "312", "1:23,357,519", "Croatia 292 (1:14,482) · Serbia 14 · Montenegro 6"],
];
---
<Base title="The Names"
  eyebrow="Four surnames, one of them almost extinct"
  dek="Blažević is the seventeenth commonest surname in Croatia. Žubrinić is held by about three hundred people on earth. Both are in this family, and the rare one is the one that travels.">

  <section class="blk">
    <h2>What they mean</h2>
    <div class="grid two">
      <div class="card">
        <h3>Blažević — “son of Blaž”</h3>
        <p>A patronymic from the given name <strong>Blaž</strong>, the Croatian form of
        <em>Blasius</em> / Blaise, itself from Latin <em>blaesus</em>, “lisping” or “stammering”.
        The suffix <strong>-ević / -ić</strong> is the ordinary South Slavic “child of”.</p>
        <p style="margin-top:1rem">It is <strong>the 17th most frequent surname in Croatia</strong>.
        Its densest counties are Split-Dalmatia, Virovitica-Podravina and Osijek-Baranja —
        <strong>not</strong> Lika-Senj. Our Blaževići sit outside the name's main clusters, which is
        a caution: <em>sharing this surname with someone is nearly meaningless as evidence.</em></p>
      </div>
      <div class="card">
        <h3>Žubrinić — the rare one</h3>
        <p>About <strong>312 bearers worldwide</strong>, of whom <strong>292 are in Croatia</strong>
        at a density of 1:14,482. Within Croatia its two great concentrations are the
        <strong>City of Zagreb (28%)</strong> and <strong>Lika-Senj County (25%)</strong> — and
        Lika-Senj is where <a href={u("/people/tereza-zubrinic-zubrinic")}>Tereza</a> and her
        forebears at <strong>Otočac</strong> are from.</p>
        <p style="margin-top:1rem">A name this rare behaves in the opposite way to Blažević: two
        Žubrinići in the Otočac registers are <em>probably</em> related. That makes it the most
        useful surname in this archive.</p>
      </div>
      <div class="card">
        <h3>Papić — “son of the priest”, or of Papa</h3>
        <p>From <strong><em>pop</em> / <em>papa</em></strong> — priest. The tree itself preserves
        the alternate form: seventy-nine of its Papići are written
        <strong><em>Papić (Papa)</em></strong>, and the direct ancestor is recorded as
        <a href={u("/people/georgius-juraj-joannis-papa-antic-papic")}>“Georgius Juraj
        (Joannis) <em>Papa</em> ‘Jure’ Antić Papić”</a> — carrying <em>Antić</em> and
        <em>Papić</em> at once. The family was changing its name in the record, in front of us.</p>
      </div>
      <div class="card">
        <h3>Prpić — and Perpić</h3>
        <p>A hypocoristic patronymic, from a short form of a given name. In this tree it is written
        <strong>Prpic 83 times, Perpic 19, Perpić 16, Prpić 8</strong> — and one record hedges
        openly as <em class="mono">“Papić or Perpic”</em>. Antonija herself is entered as
        <strong>“Perpić / Prpic”</strong>.</p>
        <p style="margin-top:1rem">Prpić concentrates in Zagreb (27%), Primorje-Gorski Kotar (17%)
        and <strong>Lika-Senj (13%)</strong> — again the family's own ground.</p>
      </div>
    </div>
  </section>

  <section class="blk">
    <div class="lab">The most important thing on this page</div>
    <h2 id="x">X wrote the sound Ž</h2>
    <p class="lede">The Žubrinić name appears in this tree in <strong>eight different
    spellings</strong>, and they are not errors. They are three successive orthographies for one
    unchanged spoken name.</p>
    <div class="grid three" style="margin-top:1.2rem">
      <div class="card">
        <h3>Xubrinich</h3>
        <p>The <strong>Venetian-Italian</strong> convention used along this coast, in which
        <strong>X</strong> stood for the sound written <strong>Ž</strong> in modern Croatian, and
        <strong>-ch</strong> for <strong>-ć</strong>. Latin-language parish registers in
        Habsburg Croatia use it constantly.</p>
      </div>
      <div class="card">
        <h3>Zubrinich</h3>
        <p>The <strong>German-Latin</strong> compromise of the imperial administration: the
        diacritic dropped because the clerk's alphabet had no way to write it, the
        <strong>-ich</strong> ending kept.</p>
      </div>
      <div class="card">
        <h3>Žubrinić</h3>
        <p><strong>Modern Croatian</strong>, after Gaj's diacritical reform of the 1830s made
        <em>ž</em> and <em>ć</em> standard. This is the form the family uses today.</p>
      </div>
    </div>
    <p style="margin-top:1.3rem">The direct ancestors are entered under both at once —
    <a href={u("/people/nicolaus-zubrinic-xubrinic")}><strong>Nicolaus “Nikola” Žubrinić
    (Xubrinic)</strong></a>, born at Otočac on 24 January 1834, and his father
    <a href={u("/people/michael-zubrinic-zubrinic-xubrinich")}><strong>Michael “Mate”
    Žubrinić / Zubrinic / Xubrinich</strong></a>, born 1811. Whoever built this tree was reading
    across all three systems, which is the right instinct.</p>
    <div class="note"><strong>The practical consequence.</strong> Searching Croatian records for
    <em>Žubrinić</em> alone will miss most of the family before about 1850. The name has to be
    searched as <em>Xubrinich</em>, <em>Zubrinich</em>, <em>Xubrinic</em> and
    <em>Zubrinic</em> as well — and this archive's own tooling folds all of them to one key before
    it counts anything.</div>
  </section>

  <section class="blk">
    <div class="lab">The surname is only half the problem</div>
    <h2>The given names change language too</h2>
    <p class="lede">These registers were kept in <strong>Latin</strong>, and then in
    <strong>Croatian</strong>. The same man is <em>Joannes</em> in the book that baptised him and
    <em>Ivan</em> in the one that married him — and a fair number of entries decline him into
    <em>Joannem</em> or <em>Joannis</em>, because a priest writing <em>baptizavi Josephum</em> is
    writing the accusative, not the name.</p>
    <p>So the archive's own register was <strong>splitting people from themselves</strong>. A reader
    searching <em>Ivan</em> was shown <strong>42</strong> of them and not the other
    <strong>46</strong>. Of {Object.keys(given.groups).length} canonical given names in this
    material, <strong>{obs.length}</strong> appear under more than one spelling.</p>
    <table class="reg" style="margin-top:1.2rem">
      <thead><tr><th>One name</th><th>People</th><th>As the registers write it</th></tr></thead>
      <tbody>
        {obs.slice(0, 18).map(([k, v, tot]) => (
          <tr>
            <td><strong style="text-transform:capitalize">{k}</strong>
              {given.sex[k] && <span class="dim"> · {given.sex[k] === "m" ? "m" : "f"}</span>}</td>
            <td class="mono">{tot}</td>
            <td class="dim">{Object.entries(v).map(([n, c], i) => (
              <>{i > 0 && " · "}<span class="mono">{n}</span> <span class="dim">×{c}</span></>))}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p style="margin-top:1.2rem"><a href={u("/people")}>The register's search box</a> now folds all
    of this: <strong>type <em>Joannis</em> and you get every Ivan</strong>; type
    <em>Tonka</em> and you get every Antonija; type <em>Georgius</em> and you get Juraj and Jure.
    The table is built from the names actually present in the data, not from a list of what Croatian
    names <em>might</em> be, and it lives in
    <code class="mono">tools/given_names.py</code>.</p>
    <div class="note"><strong>One distinction is kept rather than folded.</strong>
    <em>Franjo</em> and <em>Franciska</em> share a root, as do <em>Luka</em> and <em>Lucija</em>,
    and <em>Ante</em> and <em>Antonija</em>. They are <strong>not the same name</strong>, and this
    archive first merged them by mistake — which would have told a reader that fourteen Franciskas
    were Franjos. They are split by sex, and counted separately.</div>
  </section>

  <section class="blk">
    <div class="lab">A consequence worth its own section</div>
    <h2>Forty people in this archive are named after a case ending</h2>
    <p class="lede">These registers are <strong>narrative Latin</strong>, not forms. A priest
    writes <em>baptizavi <strong>Josephum</strong></em> — “I baptised Josephus” — and
    <em>filius <strong>Josephi</strong></em> — “son of Josephus”. Those endings are
    <strong>grammar</strong>. Transcribed literally into a family tree, they become names, and the
    tree acquires a man called <strong>Josephum</strong> who was never called that by anyone.</p>
    <p><strong>{latin.length} of the {"1,090"} people published here</strong> carry one — 20
    genitives, 18 accusatives, one dative and one ablative — and
    <strong>{latAnc.length} of them are direct ancestors of Hedviga</strong>.</p>
    <table class="reg" style="margin-top:1.2rem">
      <thead><tr><th>Recorded as</th><th>Which is</th><th>Really</th><th>Who</th></tr></thead>
      <tbody>
        {latAnc.map((l) => (
          <tr>
            <td class="mono"><strong>{l.recorded}</strong></td>
            <td class="dim">{l.case}</td>
            <td class="mono">{l.nominative}</td>
            <td>{l.slug
              ? <a href={u(`/people/${l.slug}`)}>{l.name}</a> : l.name}
              <span class="tag">ancestor</span></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="dek" style="margin-top:1rem">The other {latin.length - latAnc.length} are collateral
    and are flagged on their own pages.</p>
    <div class="fix" style="margin-top:1.4rem">
      <h3>Corrected: this archive blamed the wrong person</h3>
      <p>This page used to say the case endings were <em>one person working through a run of Selce
      and Vinodol entries</em> — a modern transcriber lifting the word after <em>baptizavi</em>.
      Three scans read since then show that is wrong. <strong>The priests wrote the oblique forms
      themselves.</strong></p>

      <table class="reg" style="margin-top:1rem">
        <thead><tr><th>Register</th><th>What the page actually says</th><th>Form</th></tr></thead>
        <tbody>
          <tr><td><strong>Vrbnik, 14 March 1806</strong><br/><span class="dim">Michaël Kombol</span></td>
            <td class="mono">…patre Joanne, Matre Marthæ Antich Papa, <strong>nomine
              Josephum</strong></td><td>accusative</td></tr>
          <tr><td><strong>Karlobag, August 1789</strong><br/><span class="dim">Andreas Baglietich</span></td>
            <td class="mono"><strong>Mariam</strong> natam pridie ex Michaele et Lucia Gergacs</td>
            <td>accusative</td></tr>
          <tr><td><strong>Karlobag, April 1777</strong><br/><span class="dim">Joannes A. Ivankovich</span></td>
            <td class="mono">cui impositum est <strong>Nomen Joannis Georgij</strong></td>
            <td>genitive</td></tr>
        </tbody>
      </table>

      <p style="margin-top:1rem">Two parishes, three priests, three decades apart. In the 1806 book
      <em>every</em> child on the page is named in the accusative — Mariam, Joannem, Matthæam,
      Magdalenam, Vincentium, Nicolaum. That is not a slip anyone made; it is how the sentence
      works. <em>Baptizavi infantem … nomine Josephum</em> — the child is the grammatical object of
      the verb, so the child's name takes the object's ending.</p>
    </div>

    <div class="note" style="margin-top:1.4rem"><strong>Which makes the ending useful.</strong>
      If the case is the register's own grammar rather than an error, it records
      <em>how that person appeared in the entry they were found in</em>:
      <ul class="plain" style="margin-top:.6rem">
        <li><strong>Accusative</strong> — <span class="mono">Josephum</span>,
          <span class="mono">Mariam</span> — they were the one being baptised. The entry is
          <em>their own</em>.</li>
        <li><strong>Genitive or dative</strong> — <span class="mono">Joannis</span>,
          <span class="mono">Pauli</span>, <span class="mono">Simoni</span> — they were named as
          somebody's parent. The entry belongs to their <em>child</em>, and they appear only in
          passing.</li>
      </ul>
      <p style="margin-top:.6rem">So the six ancestors carrying a genitive are people this archive
      has never yet seen a record <em>of</em> — only records that mention them. That is a reading
      list, not a defect.
      <a href={u("/open-questions")}>What would close them →</a></p>
    </div>

    <div class="note" style="margin-top:1.4rem"><strong>And the registers underline the by-names.</strong>
      The 1806 Vrbnik scribe rules a line under a second name after the surname —
      <span class="mono">Antich <u>Papa</u></span>, <span class="mono">Loncsarich <u>Franich</u></span>,
      <span class="mono">Antich <u>Dudin</u></span>, <span class="mono">Pobor <u>Rataj</u></span>.
      These are <strong>nadimci</strong>, house by-names that tell one household from another where
      a whole village shares a surname — the same problem the
      <a href={u("/gazetteer")}>house numbers</a> solve. It also puts a documented
      <span class="mono">Papa</span> beside the 79 people this tree writes
      <span class="mono">Papić (Papa)</span>, and leaves an open question:
      whether that is the by-name of an <em>Antić</em> household rather than a surname in its own
      right. <a href={u("/papic")}>The Papić line →</a></p>
    </div>

    <p style="margin-top:1.2rem"><strong>Nothing has been renamed.</strong> The tree is the
    authority on what the tree says, and this archive's job is to note where what it says is a
    grammatical artefact rather than to quietly correct it — the person pages carry the note, and
    <a href={u("/people")}>the search folds the forms together</a> so that
    <em>Josephum</em> and <em>Josip</em> find each other.</p>
  </section>

  <section class="blk">
    <div class="lab">Read this before you search the name</div>
    <h2>What the surname-origin websites say about Žubrinić is invented</h2>
    <p class="lede">Because <strong>Žubrinić</strong> is rare, it is exactly the kind of name that
    the automated “meaning and origin of your surname” sites fill in with confident fiction. One of
    them, consulted for this archive, produced the following — and it is worth setting out, because
    somebody researching this family <em>will</em> find it.</p>
    <table class="kv" style="margin-top:1.2rem">
      <tr><th class="warn">“A Croatian ban”</th><td>It names <strong>“Petar Žubrinić, an
        18th-century Croatian ban”</strong>. The bans of Croatia in that century were
        <strong>Pálffy, Drašković, Eszterházy, Branyng, Batthyány, Nádasdy, Esterházy, Balassa and
        Erdődy</strong>. <strong>There was no Ban Žubrinić.</strong> The claim is fabricated.</td></tr>
      <tr><th class="warn">Two etymologies</th><td>The same site derives the name from
        <em>žubor</em>, “babble” — a talkative man — <em>and</em> from <em>žubr / zubr</em>, the
        <strong>aurochs</strong>. These are unrelated words. It concedes the second is
        “<em>nije potvrđeno</em>”, unconfirmed, having just asserted the first.</td></tr>
      <tr><th class="warn">The wrong region</th><td>It states the name “originates from Dalmatia and
        is most prevalent there today”. The distribution figures below put
        <strong>25% of Croatian bearers in Lika-Senj</strong> and 28% in the City of Zagreb — the
        usual modern drift to a capital — and <strong>Dalmatia nowhere</strong>. This family's own
        records run through <strong>Otočac</strong>, in Lika, for two centuries.</td></tr>
      <tr><th>Noble status</th><td>Asserted for the 17th century, with no document, by a source that
        has already invented a viceroy.</td></tr>
    </table>
    <p style="margin-top:1.2rem"><strong>What can honestly be said</strong> is small. The name is a
    standard <strong>-ić patronymic</strong> built on a stem <em>Žubr-</em>; which personal name or
    nickname stands behind that stem is a question for Croatian onomastic scholarship, and this
    archive has not found an authority that answers it. Everything else on this page is counted, not
    guessed. <a href={u("/method")}>Method →</a></p>
    <div class="note">The general lesson is worth more than the particular one.
    <strong>A surname-origin website that cites nothing is not a weak source; it is not a source.</strong>
    The safe test is the one applied here: take its single most checkable factual claim — a named
    person holding a named office in a named century — and check it.</div>
  </section>

  <section class="blk">
    <h2>And then the name emigrates</h2>
    <p class="lede">When the family leaves, the spelling forks permanently — and the two forks can
    be counted separately.</p>
    <table class="reg" style="margin-top:1rem">
      <thead><tr><th>Form</th><th>Bearers</th><th>Where they are</th></tr></thead>
      <tbody>
        <tr><td><strong>Žubrinić</strong> <span class="dim">— the homeland form</span></td>
          <td class="mono">312</td><td>Croatia 292, Serbia 14, Montenegro 6. <strong>100% in
          Europe.</strong></td></tr>
        <tr><td><strong>Zubrinic</strong> <span class="dim">— the diaspora form</span></td>
          <td class="mono">69</td><td>Argentina 29, Canada 16, United States 8,
          <strong>South Africa 7</strong>, Netherlands 5. <strong>None in Croatia at
          all.</strong></td></tr>
      </tbody>
    </table>
    <p style="margin-top:1.2rem">The two lists do not overlap by a single country. The diacritics
    are not decoration; they are a border. And the seven in
    <strong>South Africa</strong> are on the same continent this family's own line ended up on.
    <a href={u("/port-pirie")}>The Australian branch spells it <strong>Zubrinich</strong> →</a></p>
  </section>

  <section class="blk">
    <h2>Distribution, as counted</h2>
    <table class="reg">
      <thead><tr><th>Name</th><th>Worldwide</th><th>Density</th><th>Principal countries</th></tr></thead>
      <tbody>{dist.map(([n, w, d, c]) => (
        <tr><td><strong>{n}</strong></td><td class="mono">{w}</td><td class="mono">{d}</td>
          <td class="dim">{c}</td></tr>))}</tbody>
    </table>
    <p class="dek" style="margin-top:1rem">Figures from Forebears, which builds on national
    statistical and electoral registers. They are good for orders of magnitude and for
    <em>relative</em> density; they are not a census.</p>
  </section>

  <section class="blk">
    <h2>How the tree writes them, and where</h2>
    <p class="lede">A spelling is not a fact about a family. It is a fact about the room the name
    was written down in — which parish, which clerk, which language the register kept its columns
    in. Set each spelling beside the place and the year it clusters at, and the variants stop
    looking like noise.</p>

    {vars4.map((v) => (
      <div style="margin-top:1.6rem">
        <h3>{sp(v.key) ? sp(v.key).label : v.key} <span class="dim">— {v.n} people,
          {" "}{v.forms.length} spellings</span></h3>
        <table class="reg">
          <thead><tr><th>As written</th><th>People</th><th>Chiefly at</th><th>Median year</th></tr></thead>
          <tbody>{v.forms.map((f) => (
            <tr>
              <td class="mono">{f.spelling}</td>
              <td class="mono">{f.n}</td>
              <td>{f.places.length
                ? <a href={u("/people/?q=" + encodeURIComponent(f.places[0].place))}>{f.places[0].place}</a>
                : <span class="dim">not recorded</span>}</td>
              <td class="mono">{f.median || <span class="dim">—</span>}</td>
            </tr>))}</tbody>
        </table>
      </div>
    ))}

    <div class="qa" style="margin-top:1.6rem">
      <h3>Three things that table says out loud</h3>
      <p><strong>Papić is two villages, not two families.</strong> The 79 people written
      <span class="mono">Papić (Papa)</span> sit at <strong>Selce</strong> and cluster around
      <strong>1843</strong>. The 35 written plainly <span class="mono">Papić</span> sit at
      <strong>Senj</strong> and cluster around <strong>1891</strong>. Same family, half a century
      and one move apart — the village form, then the town form. It is the
      <a href={u("/senj")}>same migration into Senj</a> the occupations already show.</p>

      <p><strong>The earliest Papić spelling is the Latin one.</strong>
      <span class="mono">Papich</span>, three people, all Selce, median <strong>1793</strong> — the
      oldest layer in the surname, written by a clerk keeping his register in Latin.</p>

      <p><strong>Žubrinić forks at the water's edge.</strong> <span class="mono">Žubrinić</span> is
      Otočac, median 1845. <span class="mono">Zubrinich</span> is
      <a href={u("/port-pirie")}>Port Pirie</a>, median 1894 — thirteen of its fifteen bearers born
      in South Australia. The diacritic did not survive the ship's manifest.
      <a href={u("/name#x")}>The X form is older still →</a></p>
    </div>
  </section>

  <section class="blk">
    <h2>Seven women on the direct line have no surname at all</h2>
    <p class="lede">Not an unknown surname — no surname. The register gave a Christian name, the
    husband's full name, and nothing else. Every one of the seven is a woman, and each is a
    dead end that no amount of reading further back can pass.</p>

    <table class="reg">
      <thead><tr><th>Ahnentafel</th><th>Recorded as</th><th>Wife of</th><th>Born</th></tr></thead>
      <tbody>{unnamed.map((w) => (
        <tr>
          <td class="mono">{w.ahn}</td>
          <td><a href={u("/people/" + w.slug)}><strong>{w.name}</strong></a>
            {w.place && <span class="dim"> — {w.place}</span>}</td>
          <td class="dim">{w.spouse || "—"}</td>
          <td class="mono">{w.byear || <span class="dim">not recorded</span>}</td>
        </tr>))}</tbody>
    </table>

    <p style="margin-top:1.2rem">One of them, <strong>ahnentafel 87</strong>, is entered in the tree
    literally as <span class="mono">Maria ?</span> — the question mark is part of the name as
    stored. She is the mother of a direct ancestor and there is no more of her than that.</p>

    <p>This is not a gap in the research. It is the shape of the record: a Catholic parish register
    of this period names a bride's father when it can and drops her family name when it cannot, and
    a woman who married in from another parish frequently arrives with a first name only. Where the
    line stops at a woman, it usually stops for this reason.
    <a href={u("/how-far-back")}>What actually ends each line →</a></p>
  </section>

  {crossed.length > 0 && (
    <section class="blk">
      <h2>Two names the tree could not assign to a family</h2>
      <p class="lede">Distinct from a spelling variant: here the record names two
      <em>different</em> families and cannot choose between them.</p>
      <ul class="plain">{crossed.map((c) => (
        <li style="margin-bottom:.9rem">
          <span class="mono">{c.given} {c.surname}</span>
          {c.bucket && c.suggests
            ? <span> — <span class="tag">Open</span> her siblings are written
                <span class="mono"> {c.siblings[0]}</span>, which looks like an answer until you
                check the father: he is a record called <span class="mono">“Senj — Unknown To be
                Sorted Papić”</span>, a sorting bucket. Those siblings were grouped by whoever
                compiled the tree, not by a register. It <em>suggests</em>
                {" "}<strong>{c.siblings[0]}</strong> and proves nothing.</span>
            : <span> — <span class="tag">Open</span> she appears only as a wife, with no parents and
                no siblings in the tree, so there is no structure to settle it against.</span>}
        </li>))}</ul>
      <p class="dek">Neither has a page of her own; both surface in the relation lists of people
      who do. Neither is resolved. The first case is the more instructive one: a household in this
      tree can be an editorial convenience rather than a family, and a surname inherited from a
      sorting bucket would be this archive's own invention rather than a finding.
      <a href={u("/method")}>How the buckets are excluded →</a></p>
    </section>
  )}

