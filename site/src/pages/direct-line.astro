---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import line from "../data/line.json";
import ancestors from "../data/ancestors.json";

const byGen = {};
for (const a of ancestors) (byGen[a.gen] ||= []).push(a);
const gens = Object.keys(byGen).map(Number).sort((a, b) => a - b);
const sourced = line.filter((p) => p.sources && p.sources.length).length;
---
<Base title="The Spine"
  eyebrow={`${line.length} generations of Blažević men`}
  dek="From Hedviga at Senj in 1926 back to a boy born about 1750 in a village barely a century old. This is the line the tree asserts — with the joint that cannot yet bear weight marked as such.">

  <section class="blk">
    <ol class="spine big">
      {line.map((p) => (
        <li class={p.gen === 3 ? "weak" : ""}>
          <span class="g">g{p.gen}</span>
          <div>
            <a href={u(`/people/${p.slug}/`)}><strong>{p.name}</strong></a>
            <span class="yrs">{p.byear || "?"}–{p.dyear || "?"}</span>
            <div class="pl">{p.bornPlace || "—"}</div>
            {p.occupations && p.occupations.length > 0 && (
              <div class="dim">{p.occupations.map((o) => o.what).filter(Boolean).join(" · ")}</div>)}
            {p.gen === 3 && <div class="warn">Still no birth or death date — but no longer
              undocumented: the 1920 marriage register names him as Ljubomir's father.</div>}
            {(!p.sources || !p.sources.length) && p.gen !== 3 &&
              <div class="warn">No source of any kind attached.</div>}
          </div>
        </li>
      ))}
    </ol>
    <p class="note"><strong>{sourced} of {line.length}</strong> generations on this spine carry a
    source string in the tree; <strong>{line.length - sourced}</strong> carry none. And a source
    string here most often means another online tree.
    <a href={u("/method/")}>Why that matters →</a></p>
  </section>

  <section class="blk">
    <div class="lab">Corrected, September 2026</div>
    <h2>The join at generation three</h2>
    <p class="lede">This section used to say that everything above
    <a href={u("/people/ljubomir-blazevic/")}>Ljubomir</a> hung on a man with
    <strong>no document at all</strong>. That was wrong. The
    <a href={u("/marriage-1920/")}><strong>Senj marriage register of 8 December 1920</strong></a>
    names the groom's parents outright — <strong>Juraj Blažević and Tereza <em>r.</em>
    Žubrinić</strong> — and it had been attached in the family tree the whole time, invisible
    because media does not travel in a GEDCOM export.</p>
    <p>So the link from Ljubomir to Juraj is <strong>documented</strong>, by a priest writing in
    1920 with the couple in front of him. It is corroborated from below, too: Ljubomir was born at
    <strong>Rijeka on 1 March 1892</strong> — the register confirms that date — while his siblings
    Anka (1893) and Ruža (1897) are recorded at <strong>Otočac</strong> and <strong>Smokvica
    Krmpotska</strong>, the mother's town and the father's village.</p>
    <div class="note"><strong>The wall moved up one generation; it did not fall.</strong> Juraj is
    now named by a record, but he is still <em>undated and unplaced</em>, and nothing yet connects
    him to <a href={u("/people/toma-tomislav-blazevic/")}>Toma</a> at generation four. The register
    also annotates him <em>mrt.</em> — deceased — which puts his death <strong>before December
    1920</strong>. <a href={u("/open-questions/")}>Open questions →</a></div>
  </section>

  <section class="blk">
    <div class="lab">Where the depth actually is</div>
    <h2>Nine generations, seventy people</h2>
    <p>The male Blažević spine is eight deep, but the tree's real reach is on the
    <strong>mothers' sides</strong> — the Pilipić and Uroda lines out of
    <strong>Karlobag</strong>, and the Antić–Jelličić lines out of <strong>Selce</strong>, both of
    which run to a ninth generation and into the <strong>1710s and 1720s</strong>.</p>
    {gens.map((g) => (
      <div class="genblk">
        <h3>Generation {g} <span class="dim">— {byGen[g].length} {byGen[g].length === 1 ? "person" : "people"}</span></h3>
        <ul class="cols">
          {byGen[g].sort((a, b) => a.ahn - b.ahn).map((p) => (
            <li><span class="mono dim">{p.ahn}</span>
              <a href={u(`/people/${p.slug}/`)}>{p.name}</a>
              <span class="yrs">{p.byear || "?"}–{p.dyear || "?"}</span></li>
          ))}
        </ul>
      </div>
    ))}
    <p class="dek">Numbered by <strong>Ahnentafel</strong>: Hedviga is 1, her father 2, her mother
    3, and every person's father is twice their number. A missing number is a missing ancestor, which
    is the point of using it.</p>
  </section>
</Base>
