---
/* THE OTHER PEOPLE WHO CARRY THE SAME NAME, on a person's page (one page per person; 23 November 2026, rolled out from Booyzen).
 * Each is a link to that person's own page, with the life span and place the name page /who/<name>/ used to show beside them.
 * `others` is built by lib/namesakes.js. Drawn inside the kit's "Others of the same name" section (#namesakes), wrapped in
 * #others-of-this-name, the address the old /who/<name>/ pages of a shared name now land on.
 * Its styles are inline attributes: a <style> block would be inlined into each of the 4,500 person pages that import it (the same
 * reason NamesakesFinds.astro, which this replaces, kept them inline). `plain` is for a living person's page, which carries no year: the
 * others are a name and a place there. */
const { others = [], plain = false } = Astro.props;
const n = others.length;
---
{n > 0 && (
  <Fragment>
    <p class="oth-lede" style="margin:1rem 0 .9rem;line-height:1.6;color:var(--ink-2)"><strong>{n === 1 ? "One other person" : `${n} other people`}</strong> in this archive {n === 1 ? "carries" : "carry"} this name.
      {" "}They are different people: this archive does not join two of them without a record that says to.</p>
    <ul class="oth-list" style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.6rem">
      {others.map((o) => (
        <li style="border-left:3px solid var(--rule-strong);padding:.35rem 0 .35rem .8rem;min-width:0;overflow-wrap:anywhere">
          <a href={o.href} style="font-size:1.05rem">{o.name}</a>
          {!plain && <span class="oth-life" style="display:block;margin-top:.15rem;font-family:var(--mono);font-size:.78rem;color:var(--ink-2)">{o.life || "no dates recorded"}</span>}
          {o.where && <span class="oth-where" style="display:block;margin-top:.15rem;font-size:.85rem;color:var(--ink-3)">{o.where}</span>}
          {!plain && o.note && <span class="oth-note" style="display:block;margin-top:.15rem;font-size:.82rem;color:var(--ink-3);font-style:italic">{o.note}</span>}
        </li>
      ))}
    </ul>
  </Fragment>
)}
