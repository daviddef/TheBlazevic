{
  "name": "blazevic-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4324",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run check:pin && npm run check:repo && npm run atlas && astro build && npm run sitemap && npm run check:living && npm run check:living-standard && npm run check:prose:build && npm run check:kin && npm run check:templates && npm run check:kit && npm run check:worklist && npm run check:covers && npm run check:found && npm run check:snapshots && npm run check:numbers && npm run check:holdings && npm run check:dates && npm run check:stamp && npm run check:pages && npm run check:familypages && npm run check:alsoin && npm run check:inline && npm run check:rows && npm run check:datalinks && npm run check:notes && npm run check:household && npm run check:nav",
    "preview": "astro preview --port 4324",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist \"${ARCHIVE_OUT:-dist}\"",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist \"${ARCHIVE_OUT:-dist}\" --data src/data --policy named-bare",
    "check:living-standard": "python3 ../tools/livingcheck.py --selftest",
    "check:prose": "python3 ../tools/prosecheck.py",
    "check:prose:build": "python3 ../tools/prosecheck.py --selftest && python3 ../tools/prosecheck.py --not-run-ok",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:found": "python3 ../tools/foundcheck.py --quiet",
    "check:holdings": "python3 ../tools/holdingscheck.py --quiet",
    "check:dates": "python3 ../tools/datecheck.py --quiet",
    "check:stamp": "python3 ../tools/regen.py --check",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root .",
    "check:pages": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpages.py --root . --estate ../.. --max-bespoke 2",
    "check:pin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpin.py --root .",
    "check:familypages": "python3 ../tools/familycheck.py --selftest && python3 ../tools/familycheck.py --dist \"${ARCHIVE_OUT:-dist}\"",
    "check:alsoin": "python3 ../tools/check_also_in.py --selftest && python3 ../tools/check_also_in.py",
    "check:nav": "python3 node_modules/@daviddef/archive-kit/kit/tools/checknav.py --dist dist --strict",
    "check:inline": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkinline.py --root . --max-inline 3",
    "check:rows": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkrows.py --root .",
    "check:numbers": "python3 ../tools/numbercheck.py",
    "check:repo": "python3 ../tools/repocheck.py",
    "check:kin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkkin.py --data src/data/people.json --born born --died died --max 6",
    "check:datalinks": "python3 ../tools/datalinks.py",
    "check:notes": "python3 ../tools/notescheck.py",
    "check:household": "python3 ../tools/householdcheck.py",
    "check:snapshots": "python3 ../tools/snapshots.py"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#dabcb63c73fe95753638f2d4230c184fd2e07def",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
