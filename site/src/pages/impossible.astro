---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import C from "../data/consistency.json";
import CAUSES from "../data/impossible.json";
import NAMES from "../data/names.json";

/* THESE WERE TYPED AND THEY DRIFTED. The page said «all 103 people here
   bearing a form of Ivan are men» and «25 of the 27 bearing a form of Lucija
   are women» — true when written, and wrong by 21 and 27 people once
   publication widened on 22 September 2026. The same table the sentence is
   about has always carried the figures; now the sentence asks it. */
const nameRow = (canon) => (NAMES.rows || []).find((r) => r.canon === canon) || {};
const IVAN = nameRow("ivan");
const LUCIJA = nameRow("lucija");

const SEV = { 1: "Impossible", 2: "Very doubtful", 3: "Worth a look" };
const KIND = {
  "child-after-parent-death": "A child born after the parent died",
  "child-before-parent-birth": "A child born before the parent",
  "parent-too-young": "A parent under thirteen",
  "parent-under-seventeen": "A parent aged thirteen to sixteen",
  "mother-too-old": "A mother over fifty",
  "died-before-born": "Died before being born",
  "married-before-birth": "Married before being born",
  "married-after-death": "Married after dying",
  "married-as-child": "Married as a child",
  "implausible-age": "Lived past a hundred and five",
  "impossible-generation-gap": "Two generations in too few years",
  "sex-contradicts-name": "A recorded sex the name contradicts",
};
const CAUSE = {
  record:     ["A contradiction in the record", "The dates as written cannot both be true. This is the only kind that is really a finding about the past rather than about the tree."],
  namesake:   ["A wrong link", "Too far apart for any slop in the dates. The join is wrong, not the dates — usually a reused name, or two people merged."],
  generation: ["A generation skipped", "The parent is barely older than the child, because a grandparent has been recorded as a parent."],
  sex:        ["A sex and a name that disagree", "The recorded sex contradicts a given name that this archive's own records show is overwhelmingly one sex. Which of the two fields is wrong is not decided here."],
  hedged:     ["Not an error at all", "A hedged date (BEF, AFT, Maybe) sitting against a firm one. The hedge is doing its job."],
};
const ORDER = ["record", "namesake", "generation", "sex", "hedged"];
const causeRows = (k) => CAUSES.filter((c) => c.cause === k);
const bySev = (n) => C.filter((i) => i.sev === n);
const counts = [1, 2, 3].map((n) => [n, bySev(n).length]);

// grouped, because the interesting unit is a person with several at once
const byPerson = {};
for (const i of C) (byPerson[i.name] ||= { name: i.name, slug: i.slug, rows: [] }).rows.push(i);
const worst = Object.values(byPerson).sort((a, b) => b.rows.length - a.rows.length).slice(0, 6);
const kindCounts = Object.entries(
  C.reduce((a, i) => ((a[i.kind] = (a[i.kind] || 0) + 1), a), {})
).sort((a, b) => b[1] - a[1]);
---
<Base title="What Cannot Be True"
  eyebrow={`${C.length} contradictions the tree makes with itself`}
  dek="No register was needed for any of these. They are things in one record that cannot all be true at once — a mother who died before her children were born, a woman married eight years after her own death, a man recorded as a woman under a name this archive gives to forty-seven men. Checking a tree against itself is the cheapest research there is, and it had never been done here.">

  <section class="blk">
    <p class="lede">This page exists because of <a href={u("/people/tereza-pecanic/")}>Tereza
    Pećanić</a>. She is a direct ancestor, and this archive published her as having
    <strong>died before 1850</strong> — while the same record married her in <strong>1858</strong>
    and gave her children until <strong>1884</strong>. Nothing external was needed to see it. Her
    own page contradicted itself, and it had done so for as long as the site existed.</p>
    <p>So <span class="mono">tools/consistency.py</span> now reads every person in this archive
    against themselves and against their own family: births after deaths, marriages before births,
    parents younger than their children — and, since 17 September, a recorded sex against a given
    name that this archive's own records show is overwhelmingly one sex. It finds
    <strong>{C.length}</strong>.</p>

    <div class="grid two" style="margin-top:1.4rem">
      <div class="card">
        <h3>By how bad</h3>
        <table class="kv"><tbody>{counts.map(([n, k]) => (
          <tr><th>{SEV[n]}</th><td><strong class="mono">{k}</strong></td></tr>))}</tbody></table>
        <p class="dek" style="margin-top:.6rem"><em>Impossible</em> means the dates are firm and
        still conflict. <em>Very doubtful</em> means one of them is hedged — <span class="mono">ABT</span>,
        <span class="mono">BEF</span> — so the conflict may be an artefact of the hedge.</p>
      </div>
      <div class="card">
        <h3>By kind</h3>
        <table class="kv"><tbody>{kindCounts.map(([k, n]) => (
          <tr><th>{KIND[k] || k}</th><td><strong class="mono">{n}</strong></td></tr>))}</tbody></table>
      </div>
    </div>
  </section>

  <section class="blk">
    <div class="lab">Added 13 September 2026</div>
    <h2>Sixty-three rows are not sixty-three mistakes</h2>
    <p class="lede">Every row above is a <em>symptom</em>. One wrong parent link reports once per
    child, so the page was counting its own consequences — and worse, it was listing four quite
    different things as though they were one. Grouping by pivot person and by cause, the
    <strong>{C.length}</strong> rows collapse to <strong>{CAUSES.length}</strong> distinct
    mistakes.</p>

    <table class="reg">
      <thead><tr><th>Kind of mistake</th><th>Causes</th><th>Rows</th><th>What it means</th></tr></thead>
      <tbody>{ORDER.map((k) => (
        <tr>
          <td><strong>{CAUSE[k][0]}</strong></td>
          <td class="mono">{causeRows(k).length}</td>
          <td class="mono dim">{causeRows(k).reduce((a, c) => a + c.n, 0)}</td>
          <td class="dim">{CAUSE[k][1]}</td>
        </tr>))}</tbody>
    </table>

    <p style="margin-top:1.2rem">The distinction matters because only one of these five is a
    finding about <em>the past</em>. A wrong link, a skipped generation and a sex that fights its
    own name are findings about <em>this tree</em>, and a hedged date conflicting with a firm one
    is not a finding at all — it is the hedge working as intended. Presenting them in one
    undifferentiated list of “contradictions” overstated the first and slandered the last.</p>

    {ORDER.map((k) => (
      <div class="qa" style="margin-top:1.4rem">
        <h3>{CAUSE[k][0]} — {causeRows(k).length}</h3>
        <p class="dek">{CAUSE[k][1]}</p>
        <table class="reg">
          <thead><tr><th>Who</th><th>Rows</th><th>The contradiction</th></tr></thead>
          <tbody>{causeRows(k).map((c) => (
            <tr>
              <td>{c.slug
                ? <a href={u("/people/" + c.slug)}>{c.name}</a>
                : <span>{c.name} <span class="dim">— no page</span></span>}</td>
              <td class="mono">{c.n}</td>
              <td class="mono dim" style="font-size:.86em">{c.rows[0]}{c.n > 1 &&
                <span class="dim"> … and {c.n - 1} more like it</span>}</td>
            </tr>))}</tbody>
        </table>
      </div>))}
  </section>

  <section class="blk">
    <h2>They are mostly one mistake, made repeatedly</h2>
    <p class="lede">Sort by person rather than by error and the shape appears at once: a
    <strong>woman attached as mother to a family she cannot have borne</strong>. Not scattered
    slips — the same slip, over and over, and almost always to a woman.</p>

    <table class="reg">
      <thead><tr><th>Person</th><th>Contradictions</th><th>What is wrong</th></tr></thead>
      <tbody>{worst.map((p) => (
        <tr>
          <td>{p.slug
            ? <a href={u("/people/" + p.slug)}><strong>{p.name}</strong></a>
            : <span><strong>{p.name}</strong> <span class="dim">— no page</span></span>}</td>
          <td class="mono">{p.rows.length}</td>
          <td class="dim">{p.rows[0].msg}</td>
        </tr>))}</tbody>
    </table>

    <div class="qa" style="margin-top:1.6rem">
      <h3>The clearest case is not on the direct line at all</h3>
      <p><strong>Vladimira Baricević</strong>, born <strong>12 December 1907</strong>, is entered as
      the mother of <strong>ten</strong> Boras children born <strong>1888 to 1911</strong> — nine of
      them before she was born, one of them in the same month. She is not a doubtful reading or a
      loose date. She is <strong>somebody else's daughter married into the wrong generation</strong>,
      and every child hangs off her.</p>
      <p>Which is exactly what happened to <a href={u("/people/maria-catharina-oreskovic-oreskovic/")}>Maria
      Catharina Orešković</a> — four children born when she was two, five and six, plus the son born
      the year before her. <a href={u("/open-questions/")}>Question 4d</a> worked that one out the
      slow way, from three parish registers. This check finds the same shape in seconds, without
      leaving the file.</p>
      <p class="dek">Thirty-eight of the {C.length} sit on people with pages here. The rest are
      relatives who appear in someone's family list without a page of their own — still worth
      naming, because a wrong join is visible from both ends.</p>
    </div>
  </section>

  {[1, 2, 3].map((sev) => (
    <section class="blk">
      <div class="lab">{SEV[sev]}</div>
      <h2>{sev === 1 ? "Dates that are firm and still conflict" : sev === 2 ? "Where one date is hedged, or a name disagrees with a sex" : "Unlikely rather than impossible"}</h2>
      {sev === 3 && <p class="lede"><strong>Added 13 September 2026:</strong> a band for parents
        aged <strong>thirteen to sixteen</strong>. This was raised because
        <a href={u("/connected/")}>George Untersinger</a>, fathering at fifteen in 1802, sat just
        under the old line of thirteen and was never flagged at all. Thirteen to sixteen is
        <em>possible</em> and uncommon, so it sits here rather than moving the line of what cannot be
        true — and two of them are the same child, Anton Blažević of 1840, whose mother was fifteen
        and whose father was sixteen. That is a couple who married very young, or a birth year that
        is wrong.<br /><br />A mother of fifty-one and a man of a hundred and eleven are
        both possible, and both are usually a mistake. These were computed from the first day this
        check existed and were <strong>held back from the page</strong> until now, on the thin
        grounds that they were not certain enough — which is the opposite of how the rest of this
        archive works. They are published here with their doubt attached.</p>}
      {sev === 2 && <p class="lede">A <span class="mono">BEF 1850</span> or
        <span class="mono"> ABT 1782</span> is somebody's estimate. These conflicts may dissolve
        if the estimate is simply wrong — which is itself worth knowing, because it means the
        estimate is doing work it cannot support.<br /><br />The <strong>name</strong> rows here
        are the other kind, and they sit at this level for the same reason: a name is strong
        evidence of a sex and not proof of one. Nothing below says which of the two fields is
        wrong — only that they cannot both be read as they stand.</p>}
      <table class="reg">
        <thead><tr><th>Who</th><th>What kind</th><th>The contradiction</th></tr></thead>
        <tbody>{bySev(sev).map((i) => (
          <tr>
            <td>{i.slug ? <a href={u("/people/" + i.slug)}>{i.name}</a> : i.name}</td>
            <td class="dim">{KIND[i.kind] || i.kind}</td>
            <td class="mono" style="font-size:.86em">{i.msg}</td>
          </tr>))}</tbody>
      </table>
    </section>
  ))}

  <section class="blk">
    <div class="lab">The case the first version missed</div>
    <h2>Two years is not enough for two generations</h2>
    <p class="lede">The checks above compare a parent's dates with a child's — which needs
    <em>both</em> to exist. Where the generation in between is undated, a contradiction falls
    straight through. Reading the <a href={u("/papic/")}>Karlobag registers</a> turned up exactly
    that, on the direct line.</p>
    <table class="kv">
      <tbody>
        <tr><th>Ahnentafel 214</th><td><a href={u("/people/caetano-bacchi/")}><strong>Caetano
          Bacchi</strong></a>, born <span class="mono">“12 January 1779 (Maybe)”</span> — the
          hedge is the tree's own</td></tr>
        <tr><th>His daughter</th><td><a href={u("/people/oliva-andreana-bacchi/")}>Oliva Andreana
          Bacchi</a> — died 15 September 1795, <strong>no birth date at all</strong></td></tr>
        <tr><th>Her daughter</th><td><a href={u("/people/oliva-maria-smojver/")}>Oliva Maria
          Smojver</a>, born <strong>11 March 1781</strong> — confirmed in the register</td></tr>
      </tbody>
    </table>
    <p style="margin-top:1.2rem">A man born in 1779 cannot be grandfather to a girl born in 1781.
    And Oliva Andreana died in 1795, so she was born well before 1781 herself — her father belongs
    somewhere around <strong>1730–1745</strong>. The 1779 baptism is real; it simply records a
    different Caetano Bacchi.</p>
    <p><strong>It takes two more ancestors with it.</strong> <a href={u("/people/angelo-bacchi/")}>Angelo
    Bacchi</a> (ahn 428) and <a href={u("/people/catharina/")}>Catharina</a> (ahn 429) are in this
    pedigree <em>only</em> because that entry names them as the child's parents. If the baptism is
    not his, they are not his parents — and Catharina is one of the
    <a href={u("/name/")}>seven women here with no surname</a>, so nothing else anchors her.</p>
    <p class="dek">The tool now also walks <strong>grandparent → undated child → grandchild</strong>
    and requires at least twenty-four years across two generations. In this archive it fires
    exactly once.</p>
  </section>

  <section class="blk">
    <div class="lab">Added 17 September 2026</div>
    <h2>Twenty-two people whose sex fights their own name</h2>
    <p class="lede">Every check above is about dates. This one is not. <span class="mono">tools/names.py</span>
    now counts, for each of the thirty-nine given-name groups, how many men and how many women in
    <em>this archive</em> bear it — read off the records, not asserted from a table. That makes a new
    question nearly free: <strong>is anyone recorded as a sex their own name contradicts?</strong>
    Twenty-two people are.</p>

    <p>The table would have been the wrong thing to ask. <span class="mono">given_names.py</span>
    declares <em class="mono">matija</em> male, and <strong>eight of the forty people written Matia
    here are women</strong> — one of them ahnentafel 13 — because Matija is unisex in Croatian and
    the table has one column for it. A table is a claim. The counts are a record. So the rule is
    drawn from the archive's own usage: a name borne by at least five people here, at least nine in
    ten of them one sex, against a person recorded as the other.</p>

    <div class="qa">
      <h3>The errors were voting on whether they were errors</h3>
      <p>The case that prompted this is <a href={u("/people/ivana-blazevic-2/")}>Ivana Blažević</a>,
      recorded <span class="mono">M</span>. Ivana is borne here by <strong>21 women and 3 people
      recorded M</strong>. Counted whole, that is <strong>87 per cent</strong> — under any threshold
      worth setting, and the check says nothing. <strong>The three wrong records were holding the
      name below the line that would have caught them.</strong></p>
      <p>So the majority is counted <em>without the person being judged</em>. Set Ivana Blažević
      aside and the other 23 are <strong>91 per cent</strong> women, and all three are found. The
      same thing happens one group over: the four “women” in the Franjo tally are not other names
      caught by the fold — <strong>they are the four records this check reports</strong>.</p>
    </div>

    <div class="qa" style="margin-top:1.4rem">
      <h3>Two couples are recorded as each other</h3>
      <p><a href={u("/people/lucija-loncaric-papic-papa/")}>Lucija Lončarić Papić</a> is recorded
      <span class="mono">M</span> and entered as the <em>husband</em> of a wife called
      <strong>Ivan</strong>, who is recorded <span class="mono">F</span>. All {IVAN.people} people
      here bearing a form of Ivan are men; {LUCIJA.women} of the {LUCIJA.people} bearing a form of
      Lucija are women.
      <a href={u("/people/lucia-zubrinic-xubrinich/")}>Lucia Žubrinić</a> and <strong>Michaël
      Kostelacz</strong> are the same shape again. In both, the sex fields follow the <em>place in
      the family</em> and not the name — which is one swap, recorded twice, and visible only
      because both halves were checked.</p>
      <p class="dek">Half of each couple has <strong>no page here</strong>, being named only in the
      other's family list. This archive has three times mistaken an unpublished person for no
      person at all. Both halves are reported.</p>
    </div>

    <div class="qa" style="margin-top:1.4rem">
      <h3>One letter, and the tree wrote it itself</h3>
      <p><a href={u("/people/joannam-papic-papa/")}>Joannam Papić</a>, born 1845 at Selce, is
      recorded <span class="mono">M</span>. <strong><em>Joannam</em> is the accusative of Joanna, a
      woman.</strong> The accusative of the man's name Joannes is <em>Joannem</em>, with an e — which
      is why the archive's given-name table files <span class="mono">joannam</span> under Ivana and
      <span class="mono">joannem</span> under Ivan. The finding is carried entirely by a letter
      somebody copied out of a register, and <a href={u("/name/")}>the same page</a> that explains
      why the case ending is there is the page that settles which name it belongs to.</p>
    </div>

    <p style="margin-top:1.4rem"><strong>Nothing here says which of the two fields is wrong, and it
    must not.</strong> <a href={u("/people/petrus-kalanj-4/")}>Petrus Kalanj</a> is a Latin
    nominative and can only be a man, so the <span class="mono">F</span> is the error. Three women
    entered as wives and mothers carry the forename <strong>Ante</strong>, which here belongs to
    forty-seven men and nobody else — there the sex and the marriage agree and it is the
    <em>name</em> that dissents. <strong>Paolo Paula Eriavaz</strong>, mother of seven children
    between 1927 and 1946, is a woman whose given-name field holds both forms and leads with the
    masculine one, so every index built from it files her first as a man. She is Paula. Each of the
    twenty-two is answered on the person's own page, and <strong>the tree itself is not
    touched</strong> — this archive reports it and does not edit it.</p>

    <div class="qa" style="margin-top:1.4rem">
      <h3>What it still misses, and the bug it found on the way</h3>
      <p>Counting the bearers exposed a fault in the counting. Eighteen name forms are filed under
      two or three languages — <em class="mono">Maria</em> is Latin, Italian and Hungarian — and the
      tally added a person once per language. <strong>The one person written Maria and recorded M
      was three men</strong>, and Mihovil had 87 bearers where it has 39. Those numbers were
      printed on <a href={u("/your-name/")}>the name page</a> until it moved to a shared component;
      they now feed this check instead, which is a worse place for a count to be wrong. Fixed at
      the source, and the twenty-two findings did not change — which is the only reassuring thing
      about it.</p>
      <p>And the check is deliberately deaf in one ear. The tallies count <em>published</em> people,
      so someone without a page contributes nothing to set aside and is judged by the whole group,
      wrong records included. <strong>Ivana Juhas, recorded M, is that person, and this check does
      not find her.</strong> It errs towards silence, which is the right direction for something
      that stops a deploy — but the gap is written down rather than left in the gaps.</p>
    </div>
  </section>

  <section class="blk">
    <h2>And it caught three people who are not people</h2>
    <p class="lede">Running the check surfaced <strong>four sorting buckets being published as
    ancestors</strong> — <span class="mono">1800-1830 Birth — Selce Papić (Papa)</span> and three
    like it. The build has always excluded research scaffolding, on the stated grounds that
    publishing it "would be a lie"; the filter simply did not recognise a name that opens with a
    year, or one reading <em>Brothers of Casparus (It Seems)</em>.</p>
    <p>They are gone. (The person count quoted here when this was written, 1,086, has since been overtaken: a surname-fold fix brought 214 more people into the archive.) They had
    children attached to them, which is how the check found them: a bucket dated
    <span class="mono">1800-1830</span> cannot be a parent to somebody born in 1824.
    <a href={u("/corrections/")}>What changed →</a></p>
  </section>

  <section class="blk">
    <div class="lab">Added 13 September 2026 — worked one at a time</div>
    <h2>The twenty “record” contradictions, gone through</h2>
    <p class="lede">The section above sorts the rows by <em>kind</em>. This one goes through the
    only kind that is a finding about the past, and asks of each what is actually wrong. They
    collapse further — into five situations and a short list of single slips.</p>

    <div class="qa">
      <h3>1. Three parents die in 1845 and have children in 1847 — and 1845 is a guess</h3>
      <p><a href={u("/people/elias-ilija-zubrinic-xubrinich/")}>Elias Žubrinić</a> (d. 1845, child
      born 1847), <strong>Phillipus Žubrinić</strong> (d. 1845, child born 1847) and a
      <strong>Maria</strong> (d. 1845, child born 1847). Three of the same shape in one family in
      one year.</p>
      <p>That looked like an epidemic. This archive has suspected one since
      <a href={u("/open-questions/")}>question 4b</a>, because Elias Žubrinić and his wife Ana
      Untersinger both died in 1845 leaving seven children. <strong>Tested, it is not an
      epidemic.</strong></p>
      <table class="kv">
        <tbody>
          <tr><th>Deaths in 1845, whole export</th><td><strong class="mono">27</strong> — against a mean of <span class="mono">25.8</span> for 1820–1880. No spike at all.</td></tr>
          <tr><th>Deaths in 1845 at a <em>Croatian</em> place</th><td><strong class="mono">0</strong></td></tr>
          <tr><th>Worst Croatian years</th><td>1875, 1880, 1867 — not 1845, which does not appear</td></tr>
        </tbody>
      </table>
      <p style="margin-top:1.2rem">The reason is in how the dates are written. <strong>Six people
      in this family carry the bare string <span class="mono">1845</span></strong> — no day, no
      month, no place, no source: Elias Žubrinić, Ana Untersinger, Phillipus Žubrinić, Martinus
      Žubrinić, a Maria born 1838 and a Maria born 1809, plus Nicolaus Kraljić. The only two 1845
      deaths in this archive that carry a <em>real</em> date — Jelena Katnić on 21 November and
      Mihovil Kalanj on 13 March — are not in this group at all.</p>
      <p><strong>An epidemic recorded in a death register produces days and months. A year applied
      in bulk produces exactly this.</strong> So “1845” here is far better read as somebody's
      estimate for a group of people who dropped out of the record together — and if it is an
      estimate, the children born in 1847 are not impossible, merely later than a guess.</p>
      <p class="dek">This weakens question 4b rather than answering it, and the
      <a href={u("/searched/")}>request to Gospić</a> should now ask a different thing: not “was there
      an epidemic in 1845” but “when did these six actually die”. A single decade of the Otočac
      death register would still settle it.</p>
    </div>

    <div class="qa" style="margin-top:1.4rem">
      <h3>2. The Boras generation, skipped</h3>
      <p>Eleven rows across four people, and they are one family making the same mistake at both
      ends of itself: <strong>a generation has been skipped twice</strong>.</p>
      <p><strong>At the bottom.</strong> Budimir Boras (1894–1954) and Marica Milković (b. 1904)
      have ten children. Eight of them — 1923, 1924, 1924, 1926, 1927, 1929, 1930, 1933 — are a
      coherent set, born when Marica was between nineteen and twenty-nine. The other two are not:
      <strong>Domagoj in 1946</strong> (Marica at 42) and <strong>Vladimira in 1960</strong>
      (Marica at 56, and <em>six years after Budimir died</em>). Those two are almost certainly
      <strong>grandchildren</strong> — children of one of the eight — attached to the grandparents
      instead.</p>
      <p><strong>At the top, the same thing.</strong>
      <a href={u("/people/joannes-ivan-boras/")}>Joannes Ivan Boras</a>, born 1855, is given
      <strong>Vladimira Baricević, born 1907</strong>, as his wife, and fourteen children hang off
      her — nine of them born before she was. A woman born in 1907 is the right age to have married
      one of <em>his sons</em>, and that is the likeliest reading: <strong>she has been put in the
      wrong generation, and Joannes's actual wife is missing from the record entirely.</strong></p>
      <p class="dek">One woman in the wrong slot accounts for eleven of the sixty-three rows on this
      page — which is the whole argument for counting causes rather than symptoms.</p>
    </div>

    <div class="qa" style="margin-top:1.4rem">
      <h3>3. One typing slip that produced three impossibilities</h3>
      <p><strong>Georgius Prpić</strong>, entered as born <strong>26 March 1962</strong> to parents
      who died in 1888 and 1891 — reported here as a child born after his father's death, a child
      born after his mother's, and a mother of 139. His own birthplace settles it:
      <span class="mono">Krivi Put 136, Senj, Lika, <strong>Austria-Hungary</strong></span>, a state
      that ceased to exist in 1918, at his parents' own house. Everything agrees with
      <strong>1862</strong>. <a href={u("/corrections/")}>What changed →</a></p>
    </div>

    <div class="qa" style="margin-top:1.4rem">
      <h3>4. Two that are already open questions</h3>
      <p><a href={u("/people/maria-catharina-oreskovic-oreskovic/")}>Maria Catharina Orešković</a>,
      born 1835, as mother of a boy baptised 1834 — this is
      <a href={u("/open-questions/")}>question 4d</a>, worked out the slow way from three parish
      registers. And <strong>Michael “Mate” Žubrinić</strong>, dead in 1863 with a son born in 1880,
      which is the <em>one man or two</em> question the
      <a href={u("/searched/")}>Gospić letter</a> exists to settle.</p>
    </div>

    <div class="qa" style="margin-top:1.4rem">
      <h3>5. And six single slips with nothing behind them</h3>
      <table class="reg">
        <tbody>
          <tr><td><strong>Antonia Šestan</strong></td><td class="mono dim">born 11 Feb 1847, died 4 Aug 1846</td>
            <td class="dek">Died before born. A one-digit year error, and the archive cannot say which of the two.</td></tr>
          <tr><td><strong>Hector Defranceschi</strong></td><td class="mono dim">born 1896, married 1835</td>
            <td class="dek">A marriage attached to the wrong man of the name.</td></tr>
          <tr><td><strong>Hellena Bellobalbić</strong></td><td class="mono dim">born 1868, married 1868</td>
            <td class="dek">Married at nought. Almost certainly her parents' marriage year, carried onto her.</td></tr>
          <tr><td><strong>Anna</strong></td><td class="mono dim">born 1809, husband born 1807 — child born 1807</td>
            <td class="dek">One of the <a href={u("/name/")}>seven women here with no surname</a>, so nothing else anchors her.</td></tr>
          <tr><td><strong>Luka Katnić</strong></td><td class="mono dim">died 1755, children born 1757 and 1768</td>
            <td class="dek">Thirteen years apart. The second child cannot be explained by a posthumous birth.</td></tr>
          <tr><td><strong>Catharina</strong> / <strong>Matia Sekula</strong></td><td class="mono dim">mothers at 60 and 51</td>
            <td class="dek">Possible, unlikely, and unresolvable without the registers.</td></tr>
        </tbody>
      </table>
    </div>

    <p style="margin-top:1.4rem" class="dek"><strong>So of twenty, three are solved, nine are two
    family-sized mis-joins, two are questions already open, and six are single slips that need a
    register.</strong> Not one of them required reading a new document — only reading the ones
    already here against each other.</p>
  </section>

  <section class="blk">
    <h2>What this does not claim</h2>
    <ul class="plain">
      <li><strong>It does not say which date is wrong.</strong> When a mother dies before her child
      is born, either date could be the bad one, and the check has no way to choose. It only says
      they cannot both stand.</li>
      <li><strong>It does not touch the tree.</strong> Nothing here has been edited at source. The
      contradictions are reproduced, not resolved — the same rule the rest of this archive follows.
      <a href={u("/method/")}>Method →</a></li>
      <li><strong>It is scoped to this family.</strong> The export carries six family trees; run
      across all 15,643 people the same check returns <strong>554</strong>. Those belong to the
      other archives, and are their business.</li>
    </ul>
  </section>
