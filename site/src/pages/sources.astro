---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import { people, evidenced } from "../lib/people.js";
import sources from "../data/sources.json";

// Work list row 59, 17 September 2026. This page was 129 lines of inline prose;
// only Falco and Defranceschi held their sources as data. They are data here
// now — src/data/sources.json — one row per source, with the field that is the
// whole argument of the page as a FIELD rather than a paragraph: `weight`.
// A state register, a parish register, a family tree and a Wikipedia article
// are four different kinds of thing, and a sources page that prints them as
// four paragraphs of similar length is quietly saying they are not.
//
// Hand-written HTML in the data, so hrefs need the site base prefixed, the same
// trap /open-questions/ and /corrections/ both fell into.
const base = (html) => String(html || "").replace(/href='\//g, `href='${u("/")}`);

const withSrc = people.filter(evidenced).length;
const fs = people.filter((p) => JSON.stringify(p.events || []).includes("familysearch")).length;

const W = sources.weights;
const LABEL = {
  state: "State record", register: "Parish register", tree: "Family tree",
  background: "Background", rejected: "Consulted, and rejected", absent: "Not consulted",
};
const ORDER = ["state", "register", "tree", "background", "rejected", "absent"];
const groups = ORDER
  .map((w) => [w, sources.rows.filter((r) => r.weight === w)])
  .filter(([, rs]) => rs.length);
---
<Base title="Sources"
  eyebrow="What this archive stands on"
  dek="A MyHeritage tree of 15,643 people, a set of Croatian parish registers reachable through FamilySearch, and national surname statistics. Their weights are very different.">

  <section class="blk">
    <div class="grid three">
      <div class="stat"><div class="n">{people.length.toLocaleString()}</div><div class="l">published people</div></div>
      <div class="stat"><div class="n">{withSrc.toLocaleString()}</div><div class="l">carry a source string of some
        kind</div></div>
      <div class="stat"><div class="n">{fs}</div><div class="l">carry a citation reaching an actual register
        image</div></div>
    </div>
    <p class="dek" style="margin-top:1.1rem"><strong>“Their weights are very different” is the
    whole page</strong>, so it is recorded as a field rather than left to the reader to infer from
    paragraph length. Every source below is filed under one of six weights, and the order they
    appear in is the order this archive trusts them.</p>
  </section>

  {groups.map(([w, rs]) => (
    <section class="blk">
      <div class="lab">{LABEL[w]} — {W[w]}</div>
      {rs.map((r) => (
        <div class="src">
          {/* Nine of these twelve now carry the address of the thing itself, and
              until 21 September 2026 not one of them did — the page linked only
              inward, to this site's own pages, which answers «what is this» and
              never «take me to it». The two that still carry nothing carry
              nothing ON PURPOSE and say so in their own note. */}
          <h2>{r.url ? <a href={r.url} rel="noopener">{r.title}</a> : r.title}</h2>
          {r.url && <p class="small mono" style="margin:-.3rem 0 .6rem">
            {r.url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")}</p>}
          <table class="kv">
            <tr><th>Held by</th><td set:html={base(r.holder)} /></tr>
            <tr><th>What it is</th><td set:html={base(r.kind)} /></tr>
          </table>
          <p set:html={base(r.what)} />
          {r.volumes ? (
            <ul class="plain">{r.volumes.map((v) => <li set:html={base(v)} />)}</ul>
          ) : null}
          {r.carries ? <p set:html={base(r.carries)} /> : null}
          {r.caution ? <div class="note" set:html={base(r.caution)} /> : null}
          {r.held ? <p class="small"><strong>Held.</strong> {r.held}</p> : null}
          {r.href ? (
            <p class="small"><a href={u(r.href + "/")}>{r.hrefLabel || "Used here →"}</a></p>
          ) : null}
        </div>
      ))}
    </section>
  ))}

  <section class="blk">
    <p class="dek">Until September 2026 this page said that <em>no</em> civil registration document
    underpinned anything here. That is no longer true — the
    <a href={u("/certificate/")}>1951 birth extract</a> came out of the MyHeritage media library,
    where it had been sitting all along, attached to Hedviga's profile and absent from the GEDCOM
    export.</p>
  </section>
</Base>

<style is:global>
  .src { border-top:1px solid var(--rule,#ddd); padding:1rem 0 .4rem; }
  .src:first-of-type { border-top:0; padding-top:.2rem; }
  .src h2 { margin:0 0 .5rem; font-size:1.02rem; }
  .src .kv { margin:0 0 .7rem; }
  .src .kv th { white-space:nowrap; font-size:9.5px; font-weight:600; letter-spacing:.11em;
    text-transform:uppercase; color:var(--ink-3,#888); }
</style>
