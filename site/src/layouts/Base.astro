---
import "@daviddef/archive-kit/styles/print.css";
import { versioner } from "@daviddef/archive-kit/lib/assetv.js";
/* every public asset gets a fingerprint, so a fix is never served stale */
const v = versioner();
import { u } from "../lib/url.js";
import SiblingArchives from "@daviddef/archive-kit/components/SiblingArchives.astro";
import SkipLink from "@daviddef/archive-kit/components/SkipLink.astro";
import SocialHead from "@daviddef/archive-kit/components/SocialHead.astro";
import JsonLd from "@daviddef/archive-kit/components/JsonLd.astro";
import VisitCount from "@daviddef/archive-kit/components/VisitCount.astro";
import ring from "@daviddef/archive-kit/data/archives.json";
const { title, description = "", dek, eyebrow, bare, noindex } = Astro.props;
const SITE = "The Blažević Archive";
const nav = [
  ["Start", [["/", "Home"], ["/trees/", "The trees"], ["/tree", "Our line, drawn"], ["/atlas/", "The Atlas"], ["/timeline", "The Timeline"], ["/how-far-back", "How Far Back"]]],
  ["Our line", [["/direct-line", "The Spine"], ["/hedviga", "Hedviga"], ["/milka", "Milka, her mother"], ["/senj", "Senj"], ["/senj-1943", "Senj, 1943"], ["/oto", "The Brother"], ["/rhodes", "Rhodes"], ["/name", "The Name"]]],
  ["The families", [["/connected", "Who They Married"], ["/blazevic", "Blažević"], ["/zubrinic", "Žubrinić"], ["/zubrinic-roots", "The Žubrinić Fragments"], ["/papic", "Papić"], ["/prpic", "Prpić"], ["/kalanj", "Kalanj"], ["/boras", "Boras"], ["/vukelic", "Vukelić"], ["/sestan", "Šestan"], ["/families", "The Families"]]],
  ["Documents", [["/marriage-1920", "The Wedding of 1920"], ["/certificate", "The Certificate"], ["/grave", "The Grave"], ["/arolsen", "The Arolsen Cards"], ["/pictures", "The Pictures"], ["/faces", "The Faces"]]],
  ["Origins", [["/bunjevci", "The Bunjevci"], ["/frontier", "The Frontier"], ["/work", "What They Did"], ["/america", "The Other Emigration"], ["/gazetteer", "The Map"], ["/by-names", "The Second Name"], ["/port-pirie", "Port Pirie"]]],
  ["People & places", [["/people", "The People"], ["/bloodline/", "Blood relatives, drawn"], ["/who/", "Every Name"], ["/register", "The Register"], ["/places", "Places"], ["/marriages/", "The Marriages"]]],
  ["Evidence", [["/harvest", "What Is Left to Read"], ["/coverage", "What Rests on a Document"], ["/impossible", "What Cannot Be True"], ["/duplicates", "The Same Person, Twice"], ["/buckets", "Labels Where the Father Should Be"], ["/stones/", "The Stones"], ["/photograph-these", "Photograph these"], ["/hungarian-press/", "The Hungarian Press"], ["/sources", "Sources"], ["/searched", "What Has Been Read"], ["/worklist/", "The work list"], ["/open-questions", "Open Questions"], ["/corrections/", "Corrections"], ["/changes/", "What changed"], ["/method", "Method"]]],
];

const here = Astro.url.pathname.replace(/\/$/, "");
// Absolute URL for the sharing tags. Without these every page shared to a
// phone or a group chat renders as a bare grey link.
const SITE_URL = "https://daviddef.github.io";
const share = dek || description ||
  "An evidence-first archive of Hedviga Blažević and the four families behind her.";
const on = (h) => here === u(h).replace(/\/$/, "");
/* which of the seven this is, worked out the same way the ring does */
const thisArchive = ring.archives.find(
  (a) => a.base === (import.meta.env.BASE_URL || "/").replace(/\/$/, "")
);
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek || description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css") + v("styles.css")} />
<SocialHead title={title} description={share} site={SITE} image="photos/hero.jpg" />
<JsonLd type={bare ? "WebSite" : "Article"} name={title} description={dek || description}
        url={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname}
        site={SITE} about={Astro.props.person} />
{noindex && <meta name="robots" content="noindex" />}
</head>
<body class={bare ? "is-home" : ""}>
<SkipLink />
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Blažević <em>Archive</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={on(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/search/")}>Search</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={on(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}</div>
  </div>
</header>

<main id="main" tabindex="-1">
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead">{dek}</p>}
      </div>
    )}
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <SiblingArchives />
    <p class="foot">An evidence-first archive of the Blažević family of Senj and Smokvica Krmpotska —
    and of the Žubrinići of Otočac, the Papići of Selce and the Prpići of Krivi Put. Every claim
    carries its confidence, or is marked as unproven. <strong>Living people are named</strong> — name and relationship only, never a date, a place, a photograph or a record. <strong>This archive currently holds none.</strong></p>
    <p class="foot dim">Built {new Date().getFullYear()} ·
      <a href={u("/sources/")}>Sources</a> ·
      <a href={u("/method/")}>Method</a> ·
      <a href={u("/open-questions/")}>Open questions</a> ·
      <a href={u("/corrections/")}>Corrections</a> ·
      Corrections are the most valuable thing you can send</p>
    <VisitCount code={thisArchive?.counter} />
  </div>
</footer>

<script is:inline>
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>
  <script src={u("/wholink.js") + v("wholink.js")} defer></script>
</body>
</html>
