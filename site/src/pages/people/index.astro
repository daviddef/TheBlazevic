---
import Base from "../../layouts/Base.astro";
import NameLists from "@daviddef/archive-kit/components/NameLists.astro";
import FilterTable from "@daviddef/archive-kit/components/FilterTable.astro";
import { u } from "../../lib/url.js";
import { people, lifespan, evidenced } from "../../lib/people.js";
import families from "../../data/families.json";
import given from "../../data/givennames.json";
import B from "../../data/buckets.json";
import D from "../../data/duplicates.json";

const rows = [...people].sort((a, b) =>
  (a.surname || "").localeCompare(b.surname || "") ||
  (a.byear || 9999) - (b.byear || 9999) || a.name.localeCompare(b.name));
const withSrc = rows.filter(evidenced).length;
const ancestors = rows.filter((p) => p.ancestor).length;
const label = Object.fromEntries(families.map((f) => [f.slug, f.label]));
const linked = B.connected;
const surplus = (D.groups || []).filter((g) => !g.tier.startsWith("rejected"))
  .reduce((a, g) => a + (g.n - 1), 0);
const distinct = rows.length - surplus;
const pctLinked = Math.round(100 * B.connected / B.publishedTotal);
---
<Base title="The People" eyebrow={`${rows.length.toLocaleString()} published records, about ${distinct.toLocaleString()} distinct people`}
  dek="Everybody in the tree carrying one of this archive's eight surnames, who is judged dead and is not a working placeholder. Living people are not here. This is a count of RECORDS, not of people: some are the same person entered twice, and a published record is not a proven relative. Both caveats are quantified below.">

<NameLists here="people" u={u} />



  <section class="blk">
    <div class="grid three">
      <div class="stat"><div class="n">{rows.length.toLocaleString()}</div><div class="l">published
        people</div></div>
      <div class="stat"><div class="n">{distinct.toLocaleString()}</div><div class="l">distinct
        people — {surplus} of the records above are <a href={u("/duplicates")}>the same person
        twice</a></div></div>
      <div class="stat"><div class="n">{pctLinked}%</div><div class="l">connected to Hedviga
        without a <a href={u("/buckets/")}>sorting label</a></div></div>
      <div class="stat"><div class="n">{ancestors}</div><div class="l">direct ancestors of
        Hedviga</div></div>
      <div class="stat"><div class="n">{withSrc.toLocaleString()}</div><div class="l">carry at least
        one source string; {(rows.length - withSrc).toLocaleString()} carry none</div></div>
    </div>
    <p class="note" style="margin-top:1.2rem"><strong>{(rows.length - linked).toLocaleString()} of
    these {rows.length.toLocaleString()} people reach Hedviga only through a sorting label</strong> —
    a working note sitting where an ancestor should be. That is not a claim they are invented; the
    register entries behind them are real. It is a statement about the join, and it is marked on
    each person's own page. <a href={u("/buckets/")}>Labels where the father should be →</a></p>

    <p class="note" style="margin-top:1.2rem">A source string here usually means
    <em>another online tree</em>. It is a witness, not a document. The column is shown because the
    difference between “someone else also says this” and “a register says this” is the whole
    difference between a family story and a family history. <a href={u("/method/")}>Method →</a></p>
  </section>

  <section class="blk">
    <FilterTable
      unit="records"
      fold={Object.fromEntries(Object.entries(given.groups).flatMap(([k, vs]) => vs.map((v) => [v, k])))}
      empty="Nothing matches. Try a shorter search — this box folds the spellings together, so zubrin finds Žubrinić, Xubrinich and Zubrinich alike, and Joannis finds every Ivan."
      columns={[{ label: "Name" }, { label: "Lived", cls: "mono" }, { label: "Born at", cls: "dim" },
                { label: "Line", cls: "dim" }, { label: "Ev.", cls: "mono" }]}
      facets={[
        { key: "fam", label: "Line", all: "All lines",
          options: families.map((f) => ({ v: f.slug, label: f.label })) },
        { key: "anc", label: "Only", all: "Everyone", options: [{ v: "1", label: "Direct ancestors" }] },
        { key: "src", label: "Sources", all: "Any", options: [
          { v: "1", label: "With a source" }, { v: "0", label: "With none" }] },
      ]}
      rows={rows.map((p) => ({
        /* The place cell prints ONE of the two - born if there is one, died
           otherwise - so the other is searchable only if it is declared. That
           is the whole of what this row does not already say on screen; the
           name and the lifespan are in the cells beside it. */
        extraHay: (p.bornPlace && p.diedPlace && p.diedPlace !== p.bornPlace
          ? p.diedPlace : "").toLowerCase(),
        facets: { fam: p.family || "", anc: p.ancestor ? "1" : "0", src: evidenced(p) ? "1" : "0" },
        cells: [
          `<a href="${u(`/people/${p.slug}/`)}">${p.name}</a>` + (p.ancestor ? ' <span class="tag">ancestor</span>' : ""),
          lifespan(p) || "",
          p.bornPlace || p.diedPlace || "",
          label[p.family] || p.surname || "",
          evidenced(p) ? "·" : "—",
        ],
      }))} />
  </section>


</Base>
